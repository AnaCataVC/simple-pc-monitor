<Window x:Class="SimplePCMonitor.UI.ProcessDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Diagnostics &amp; Properties"
        Height="570" Width="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BgApp}" CornerRadius="12" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar (Drag handle & close) -->
                <RowDefinition Height="40"/>
                <!-- Main Content Area -->
                <RowDefinition Height="*"/>
                <!-- Bottom Action Bar -->
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- 1. Custom TitleBar -->
            <Grid Grid.Row="0" Background="{DynamicResource BgCard}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="{DynamicResource IconInfo}" Fill="{DynamicResource AccentMem}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Process Diagnostics &amp; Properties" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="40" Height="40" Background="Transparent" Foreground="{DynamicResource TextMuted}" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- 2. Main Content Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10,14,6">
                <StackPanel>
                    <!-- Header Card: Process Identity -->
                    <Border Style="{DynamicResource MetricCardStyle}" Margin="0,0,0,8" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Process Emblem -->
                            <Border Grid.Column="0" Background="{DynamicResource BgControl}" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Process Names & Publisher -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Name="TxtFriendlyName" Text="Process Friendly Name" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Name="TxtProcessExeName" Text="process.exe" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Name="TxtPublisherName" Text="Publisher Name" FontSize="11" Foreground="{DynamicResource AccentMem}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Badges (PID, Architecture, Protection) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock Name="TxtPidBadge" Text="PID: 00000" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                                <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock Name="TxtArchBadge" Text="64-bit" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                </Border>
                                <Border Name="BadgeProtected" Background="#25FF7E8D" CornerRadius="4" Padding="6,3" Visibility="Collapsed">
                                    <TextBlock Text="Protected System Process" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusCrit}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Memory & Resource KPI Grid (4 Cards) -->
                    <UniformGrid Columns="4" Margin="0,0,0,8">
                        <!-- Card 1: Working Set (Physical RAM) -->
                        <Border Style="{DynamicResource MetricCardStyle}" Margin="2">
                            <StackPanel>
                                <TextBlock Text="PHYSICAL RAM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtWorkingSet" Text="0.0 MB" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentMem}" Margin="0,2,0,0"/>
                                <TextBlock Name="TxtRamPercent" Text="0.0% of Total RAM" FontSize="9" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Peak Working Set -->
                        <Border Style="{DynamicResource MetricCardStyle}" Margin="2">
                            <StackPanel>
                                <TextBlock Text="PEAK RAM USE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtPeakWorkingSet" Text="0.0 MB" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                <TextBlock Text="Historical high" FontSize="9" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Private Dedicated Bytes -->
                        <Border Style="{DynamicResource MetricCardStyle}" Margin="2">
                            <StackPanel>
                                <TextBlock Text="PRIVATE COMMITTED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtPrivateBytes" Text="0.0 MB" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                <TextBlock Text="Unshared memory" FontSize="9" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Threads & Handles -->
                        <Border Style="{DynamicResource MetricCardStyle}" Margin="2">
                            <StackPanel>
                                <TextBlock Text="THREADS / HANDLES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtThreadsHandles" Text="0 / 0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}" Margin="0,2,0,0"/>
                                <TextBlock Name="TxtPriority" Text="Normal Priority" FontSize="9" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Runtime & Window State -->
                    <Border Style="{DynamicResource MetricCardStyle}" Margin="0,0,0,8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="EXECUTION &amp; RUNTIME STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Start Time &amp; Uptime:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Name="TxtStartTime" Text="2026-08-18 00:00:00" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text=" (Active: " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Name="TxtUptime" Text="0h 00m" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusOk}"/>
                                    <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Window Title:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtWindowTitle" Text="None (Background Process / Service)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Process Responsiveness:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtResponding" Text="Active &amp; Responding Normally" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusOk}" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Binary & File Metadata -->
                    <Border Style="{DynamicResource MetricCardStyle}" Margin="0,0,0,8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="FILE &amp; EXECUTABLE DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Executable Location:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtExePath" Text="C:\Windows\System32\..." FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="File Description:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtFileDescription" Text="N/A" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="File &amp; Product Version:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtVersion" Text="1.0.0.0" FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Legal Copyright:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtCopyright" Text="N/A" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Bottom Action Bar -->
            <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="0,1,0,0" Padding="14,8">
                <DockPanel>
                    <!-- Left Actions: Explore, Search, Copy -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Name="BtnOpenFolder" Style="{DynamicResource QuickActionButtonStyle}" Padding="10,6" Margin="0,0,6,0" Click="BtnOpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconLaunch}" Fill="{DynamicResource TextPrimary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Folder" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnSearchGoogle" Style="{DynamicResource QuickActionButtonStyle}" Padding="10,6" Margin="0,0,6,0" Click="BtnSearchGoogle_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Search Online" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnCopyDiagnostic" Style="{DynamicResource QuickActionButtonStyle}" Padding="10,6" Margin="0,0,6,0" Click="BtnCopyDiagnostic_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Diagnostic" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Actions: Kill & Close -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Name="BtnEndProcess" Style="{DynamicResource QuickActionButtonStyle}" Background="#2BFF7E8D" Padding="12,6" Margin="0,0,8,0" Click="BtnEndProcess_Click">
                            <TextBlock Text="✕ End Process" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusCrit}"/>
                        </Button>

                        <Button Content="Close" Style="{DynamicResource QuickActionButtonStyle}" Padding="16,6" Click="BtnClose_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
