                            </Button>
                            <Button Name="BtnWidgetExpand" Style="{DynamicResource WindowCaptionButtonStyle}" Width="22" Height="20" ToolTip="Restaurar a Modo Completo (Doble clic)" Click="MenuViewFull_Click">
