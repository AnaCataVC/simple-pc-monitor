                                                <!-- VRAM Breakdown -->
                                                <DockPanel Margin="0,2,0,2">
                                                    <TextBlock Name="TxtGpuVramTitle" Text="MEMORIA DE VIDEO DEDICADA (VRAM)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
