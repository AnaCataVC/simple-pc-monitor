<Window x:Class="SimplePCMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple PC Monitor"
        Height="720" Width="1040"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ContextMenu x:Key="TrayContextMenu" Placement="MousePoint">
            <MenuItem Name="TrayMenuOpen" Header="🖥️ Abrir Simple PC Monitor" FontWeight="Bold" Click="TrayMenuOpen_Click"/>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuPower" Header="⚡ Plan de Energía">
                <MenuItem Name="TrayMenuPlanSaver" Header="🌱 Modo Ahorro (Eco)" Click="BtnPlanSaver_Click"/>
                <MenuItem Name="TrayMenuPlanBalanced" Header="⚖️ Modo Equilibrado (Balanced)" Click="BtnPlanBalanced_Click"/>
                <MenuItem Name="TrayMenuPlanHighPerf" Header="🚀 Modo Rendimiento (Turbo)" Click="BtnPlanHighPerf_Click"/>
            </MenuItem>
            <MenuItem Name="TrayMenuOptimize" Header="🧹 Optimizar Memoria RAM" Click="BtnOptimize_Click"/>
            <MenuItem Name="TrayMenuCleanTemp" Header="🗑️ Limpiar Temporales (%TEMP%)" Click="BtnCleanTemp_Click"/>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuViewModes" Header="📐 Modo de Visualización">
                <MenuItem Header="🖥️ Dashboard Completo" Click="MenuViewFull_Click"/>
                <MenuItem Header="📊 Modo Compacto (Hero)" Click="MenuViewHero_Click"/>
                <MenuItem Header="📌 Mini Widget Flotante" Click="MenuViewWidget_Click"/>
            </MenuItem>
            <MenuItem Name="TrayMenuSettings" Header="⚙️ Preferencias">
                <MenuItem Name="TrayMenuMinToTray" Header="📥 Minimizar a la bandeja" IsCheckable="True" Click="TrayMenuMinToTray_Click"/>
                <MenuItem Name="TrayMenuCloseToTray" Header="❌ Cerrar a la bandeja" IsCheckable="True" Click="TrayMenuCloseToTray_Click"/>
                <MenuItem Name="TrayMenuRunAtStartup" Header="🚀 Iniciar con Windows" IsCheckable="True" Click="TrayMenuRunAtStartup_Click"/>
                <MenuItem Name="TrayMenuAlwaysOnTop" Header="📌 Siempre visible" IsCheckable="True" Click="BtnPinTop_Click"/>
            </MenuItem>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuTools" Header="🛠️ Herramientas de Windows">
                <MenuItem Header="📊 Administrador de Tareas" Click="BtnTaskMgr_Click"/>
                <MenuItem Header="📈 Monitor de Recursos" Click="BtnResMon_Click"/>
                <MenuItem Header="⚙️ Servicios de Windows" Click="MenuOpenServices_Click"/>
            </MenuItem>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuExit" Header="🚪 Salir de Simple PC Monitor" Click="TrayMenuExit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Outer Card with Smooth Acrylic/Glass Elevation -->
    <Border Name="OuterBorder" Background="{DynamicResource BgApp}" CornerRadius="14" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.32" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- ========================================================================= -->
            <!-- 1. FULL HUD & HERO VIEW CONTAINER                                         -->
            <!-- ========================================================================= -->
            <Grid Name="ContainerMainView" Margin="14" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Caption TitleBar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Streamlined Command Ribbon -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: 6 Bento Hardware Metric Cards (CPU, GPU, NPU, RAM, Disk, Net) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Live Historical Wave Sparklines -->
                    <RowDefinition Height="Auto" Name="RowLiveWaves"/>
                    <!-- Row 4: Deep-Dive Workspace Area (Full HUD only) -->
                    <RowDefinition Height="*" Name="RowDeepDive"/>
                    <!-- Row 5: Minimal Status Footer (Full HUD only) -->
                    <RowDefinition Height="Auto" Name="RowFooter"/>
                </Grid.RowDefinitions>

                <!-- ========================================================================= -->
                <!-- ROW 0: WINDOW TITLE BAR                                                   -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="0" Margin="0,0,0,8" Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Branding & Status Badges -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Name="ImgAppLogo" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Simple PC Monitor" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                            <TextBlock Name="TxtCpuCoresBadge" Text="16 Cores" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>
                        <Border Name="BorderUptime" Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,1.5" Margin="5,0,0,0" ToolTip="Tiempo continuo que la computadora lleva encendida desde el último reinicio">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️ " FontSize="8.5" VerticalAlignment="Center"/>
                                <TextBlock Name="TxtUptime" Text="Uptime: 0d 0h" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Draggable Space -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Pinned Window Caption Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnPinTop" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Pin Window on Top (Always on Top)" Click="BtnPinTop_Click">
                            <Path Name="PathPin" Data="{DynamicResource IconPin}" Fill="{DynamicResource TextMuted}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnMinimize" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Minimize" Click="BtnMinimize_Click">
                            <Path Data="{DynamicResource IconMinimize}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnMaximize" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Maximize / Restore" Click="BtnMaximize_Click">
                            <Path Name="PathMaximize" Data="{DynamicResource IconMaximize}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnClose" Style="{DynamicResource WindowCloseButtonStyle}" ToolTip="Close" Click="BtnClose_Click">
                            <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 1: STREAMLINED 2-TIER COMMAND RIBBON                                  -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="1" Margin="0,0,0,8" Name="ContainerRibbon">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Core Action Group -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Viewport, Tools & Settings -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Core Performance Actions & Segmented Power Plan -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnOptimize" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Trim Working Set &amp; Optimize RAM" Click="BtnOptimize_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconPower}" Fill="{DynamicResource AccentMem}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Name="TxtBtnOptimize" Text="Optimizar RAM"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnCleanTemp" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Safely Clean Temporary Files (%TEMP%)" Click="BtnCleanTemp_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconBroom}" Fill="{DynamicResource AccentDisk}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Name="TxtBtnCleanTemp" Text="Limpiar Temp"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnSnapshotTop" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Copy Diagnostic Snapshot (Markdown) to Clipboard" Click="BtnSnapshot_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconCamera}" Fill="{DynamicResource AccentCpu}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Name="TxtBtnSnapshot" Text="Captura"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="14" Background="{DynamicResource BorderCard}" Margin="6,0"/>

                        <!-- Segmented Power Plan Selector -->
                        <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="2,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                <Button Name="BtnPlanSaver" Content="Eco" Style="{DynamicResource SegmentedPillButtonStyle}" ToolTip="Switch to Power Saver Mode" Click="BtnPlanSaver_Click"/>
                                <Button Name="BtnPlanBalanced" Content="Balanced" Style="{DynamicResource SegmentedPillButtonStyle}" ToolTip="Switch to Balanced Mode" Click="BtnPlanBalanced_Click"/>
                                <Button Name="BtnPlanHighPerf" Content="Turbo" Style="{DynamicResource SegmentedPillButtonStyle}" ToolTip="Switch to High Performance Mode" Click="BtnPlanHighPerf_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Tools Dropdown, View Mode, Theme, Language & Interval -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tools Split Dropdown -->
                        <Button Name="BtnToolsMenu" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Windows Diagnostic Tools" Click="BtnToolsMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconLaunch}" Fill="{DynamicResource TextSecondary}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Name="TxtBtnTools" Text="Herramientas ▾"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuWindowsTools">
                                    <MenuItem Name="MenuToolsTaskMgr" Header="📊 Administrador de Tareas (Task Manager)" Click="BtnTaskMgr_Click"/>
                                    <MenuItem Name="MenuToolsResMon" Header="📈 Monitor de Recursos (Resmon)" Click="BtnResMon_Click"/>
                                    <MenuItem Name="MenuToolsStorageSense" Header="🛡️ Sensor de Almacenamiento (Storage Sense)" Click="BtnPCMgr_Click"/>
                                    <MenuItem Name="MenuToolsServices" Header="⚙️ Gestión de Servicios de Windows" Click="MenuOpenServices_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Border Width="1" Height="14" Background="{DynamicResource BorderCard}" Margin="4,0"/>

                        <!-- View Mode Switcher Dropdown -->
                        <Button Name="BtnToggleView" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Modo de Vista (Completo / Compacto / Mini Widget)" Click="BtnToggleView_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="TxtViewMode" Text="Completo" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=" ▾" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuViewModes">
                                    <MenuItem Name="MenuViewFullItem" Header="🖥️ Modo Completo (Dashboard + Procesos)" Click="MenuViewFull_Click"/>
                                    <MenuItem Name="MenuViewHeroItem" Header="📊 Modo Compacto (Tarjetas y Ondas)" Click="MenuViewHero_Click"/>
                                    <MenuItem Name="MenuViewWidgetItem" Header="📌 Modo Mini Widget (Barra Flotante)" Click="MenuViewWidget_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Theme Switcher Dropdown -->
                        <Button Name="BtnToggleTheme" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Tema Visual (Dark, Light, Neon, Rose)" Click="BtnToggleTheme_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconTheme}" Fill="{DynamicResource AccentMem}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Name="TxtCurrentTheme" Text="Dark" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=" ▾" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuThemes">
                                    <MenuItem Name="MenuThemeDarkItem" Header="🌙 Pastel Dark (Oscuro)" Click="MenuThemeDark_Click"/>
                                    <MenuItem Name="MenuThemeLightItem" Header="☀️ Pastel Light (Claro)" Click="MenuThemeLight_Click"/>
                                    <MenuItem Name="MenuThemeNeonItem" Header="⚡ Pastel Neon (Cyberpunk)" Click="MenuThemeNeon_Click"/>
                                    <MenuItem Name="MenuThemeRoseItem" Header="🌸 Pastel Rose (Rosa Pastel)" Click="MenuThemeRose_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Language Switcher Dropdown (ES / EN) -->
                        <Button Name="BtnToggleLang" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Idioma / Change Language" Click="BtnToggleLang_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="TxtCurrentLang" Text="ES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=" ▾" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuLanguages">
                                    <MenuItem Header="Español" Click="MenuLangEs_Click"/>
                                    <MenuItem Header="English" Click="MenuLangEn_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Refresh Interval (3s / 5s) -->
                        <Button Name="BtnToggleInterval" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Intervalo de Refresco (3s / 5s)" Click="BtnToggleInterval_Click">
                            <TextBlock Name="TxtInterval" Text="3s" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>

                        <Border Width="1" Height="14" Background="{DynamicResource BorderCard}" Margin="4,0"/>

                        <!-- Options & Tray Settings Dropdown -->
                        <Button Name="BtnSettingsMenu" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Configuración del Sistema y Bandeja" Click="BtnSettingsMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconSettings}" Fill="{DynamicResource TextSecondary}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Name="TxtBtnSettings" Text="Opciones ▾" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuAppSettings">
                                    <MenuItem Name="MenuSettingMinToTray" Header="📥 Minimizar a la bandeja" IsCheckable="True" Click="TrayMenuMinToTray_Click"/>
                                    <MenuItem Name="MenuSettingCloseToTray" Header="❌ Cerrar a la bandeja" IsCheckable="True" Click="TrayMenuCloseToTray_Click"/>
                                    <MenuItem Name="MenuSettingStartup" Header="🚀 Iniciar con Windows" IsCheckable="True" Click="TrayMenuRunAtStartup_Click"/>
                                    <Separator Margin="0,3"/>
                                    <MenuItem Name="MenuSettingAlwaysOnTop" Header="📌 Siempre visible" IsCheckable="True" Click="BtnPinTop_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 2: 6 BENTO HARDWARE METRIC CARDS                                      -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="2" Margin="-3,0,-3,6" Name="ContainerHeroGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. CPU CARD -->
                    <Border Grid.Column="0" Style="{DynamicResource BentoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconCpu}" Fill="{DynamicResource AccentCpu}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardCpuTitle" Text="PROCESADOR" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtCpuCores" Text="16 Cores" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtCpuVal" Text="0.0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressCpu" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentCpu}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtCpuSub" Text="Direct Win32 Kernel" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 2. GPU CARD -->
                    <Border Grid.Column="1" Style="{DynamicResource BentoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconGpu}" Fill="{DynamicResource AccentGpu}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardGpuTitle" Text="GRÁFICOS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtGpuTypeBadge" Text="3D Engine" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtGpuVal" Text="0.0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressGpu" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentGpu}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtGpuSub" Text="Intel Arc Graphics" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 3. NPU (AI ACCELERATOR) CARD -->
                    <Border Grid.Column="2" Style="{DynamicResource BentoCardStyle}" Name="CardNpu">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconNpu}" Fill="{DynamicResource AccentNpu}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardNpuTitle" Text="NPU (IA)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtNpuStatusBadge" Text="Idle" DockPanel.Dock="Right" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentNpu}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtNpuVal" Text="0.0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressNpu" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentNpu}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtNpuSub" Text="Intel AI Boost" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 4. MEMORY (RAM) CARD -->
                    <Border Grid.Column="3" Style="{DynamicResource BentoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconRam}" Fill="{DynamicResource AccentMem}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardRamTitle" Text="MEMORIA RAM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtRamTotalBadge" Text="16 GB" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtRamVal" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressRam" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentMem}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtRamSub" Text="0 / 16 GB Used" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 5. STORAGE DISK CARD -->
                    <Border Grid.Column="4" Style="{DynamicResource BentoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconDisk}" Fill="{DynamicResource AccentDisk}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardDiskTitle" Text="ALMACENAMIENTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtDiskTotalBadge" Text="C:" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtDiskVal" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressDisk" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentDisk}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtDiskSub" Text="0 GB Free" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 6. NETWORK CARD -->
                    <Border Grid.Column="5" Style="{DynamicResource BentoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconNetwork}" Fill="{DynamicResource AccentNet}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardNetTitle" Text="RED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtNetPingBadge" Text="-- ms" DockPanel.Dock="Right" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentNet}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtNetVal" Text="0 KB/s" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressNet" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentNet}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtNetSub" Text="↓ 0  ↑ 0 KB/s" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 3: LIVE REAL-TIME WAVE SPARKLINE CHARTS                               -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="3" Margin="-3,0,-3,6" Name="ContainerLiveWaves">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU 30s Sparkline -->
                    <Border Grid.Column="0" Style="{DynamicResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Name="TxtWaveCpuTitle" Text="CARGA DE CPU (ONDA 30s EN VIVO)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Name="TxtCpuLivePeak" Text="Peak: 0%" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource AccentCpu}"/>
                            </DockPanel>
                            <Canvas Grid.Row="1" Name="CanvasCpuGraph" Height="50" ClipToBounds="True" Background="Transparent">
                                <Polygon Name="PolyCpuArea" Fill="{DynamicResource AccentCpuAlpha}"/>
                                <Polyline Name="LineCpuStroke" Stroke="{DynamicResource AccentCpu}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Network / GPU 30s Sparkline -->
                    <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Name="TxtWaveNetTitle" Text="TRÁFICO DE RED (ONDA 30s EN VIVO)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Name="TxtNetLivePeak" Text="Peak: 0 KB/s" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource AccentNet}"/>
                            </DockPanel>
                            <Canvas Grid.Row="1" Name="CanvasNetGraph" Height="50" ClipToBounds="True" Background="Transparent">
                                <Polygon Name="PolyNetArea" Fill="{DynamicResource AccentNetAlpha}"/>
                                <Polyline Name="LineNetStroke" Stroke="{DynamicResource AccentNet}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 4: DEEP DIVE WORKSPACE (STORAGE/HARDWARE + TABBED DETAILED VIEWS)     -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="4" Margin="-3,0" Name="ContainerDeepDive">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Hardware & Drive Deck (270px) -->
                        <ColumnDefinition Width="270"/>
                        <!-- Right: Tabbed Deep-Dive Area -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: HARDWARE SUMMARY & DRIVES -->
                    <StackPanel Grid.Column="0">
                        <!-- Hardware Overview Card -->
                        <Border Style="{DynamicResource MetricCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconHardware}" Fill="{DynamicResource AccentHardware}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Name="TxtHwDeckTitle" Text="SYSTEM &amp; HARDWARE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock Name="TxtBatteryState" Text="AC Power" DockPanel.Dock="Right" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusOk}"/>
                                </DockPanel>

                                <TextBlock Name="TxtHwCpuLabel" Text="PROCESSOR" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtHwCpu" Text="Intel Core Ultra 7 155H" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Name="TxtHwGpuLabel" Text="GRAPHICS ADAPTER" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtHwGpu" Text="Intel Arc Graphics" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Name="TxtHwNpuLabel" Text="NPU AI ENGINE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtHwNpu" Text="Intel AI Boost" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentNpu}" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Name="TxtHwOsLabel" Text="OPERATING SYSTEM" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Name="TxtHwOs" Text="Windows 11" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock Name="TxtHwPowerSchemeLabel" Text="POWER SCHEME" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Name="TxtActivePowerPlan" Text="Balanced" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentHardware}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Storage Volumes Card -->
                        <Border Style="{DynamicResource MetricCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconDisk}" Fill="{DynamicResource AccentDisk}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Name="TxtStorageDeckTitle" Text="STORAGE VOLUMES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl Name="ListDrives">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="6,4" Margin="0,2">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel Grid.Row="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding VolumeLabel}" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding FreeGB, StringFormat='{}{0:N0} GB Free'}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <Button Content="📂" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Open in Explorer" Click="BtnDriveOpen_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ProgressBar Grid.Row="1" Value="{Binding PercentUsed}" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentDisk}" Margin="0,3,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN: TABBED DEEP DIVE WORKSPACE -->
                    <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Clean Tab Header without side box -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="TabBtnProcesses" Content="📊 Procesos" Style="{DynamicResource ActiveTabHeaderButtonStyle}" Click="TabBtnProcesses_Click"/>
                                    <Button Name="TabBtnAccelerators" Content="⚡ Aceleradores (GPU/NPU)" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnAccelerators_Click"/>
                                    <Button Name="TabBtnServices" Content="⚙️ Servicios" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnServices_Click"/>
                                    <Button Name="TabBtnTasks" Content="⏱️ Tareas Programadas" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnTasks_Click"/>
                                    <Button Name="TabBtnStartup" Content="🚀 Apps de Inicio" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnStartup_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 1. TOP PROCESSES VIEW -->
                            <Grid Grid.Row="1" Name="ViewProcesses" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColPid" Text="PID" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Name="TxtColApp" Text="APLICACIÓN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="2" Name="TxtColWorkingSet" Text="MEMORIA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Name="TxtColRamPercent" Text="% RAM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Name="TxtColActions" Text="ACCIONES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- Process List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ListProcesses">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3.5" Margin="0,1.5" Cursor="Hand" MouseLeftButtonDown="ProcessRow_MouseLeftButtonDown" Tag="{Binding}">
                                                    <Border.ToolTip>
                                                        <ToolTip Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Padding="8">
                                                            <StackPanel MaxWidth="300">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentMem}"/>
                                                                <TextBlock Text="{Binding SubtitleText}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,3"/>
                                                                <Separator Background="{DynamicResource BorderCard}" Margin="0,1,0,3"/>
                                                                <TextBlock Text="{Binding MemoryDisplay, StringFormat='RAM: {0}'}" FontSize="9.5" Foreground="{DynamicResource TextPrimary}"/>
                                                                <TextBlock Text="{Binding ExecutablePath, StringFormat='Path: {0}'}" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                                <TextBlock Text="💡 Doble clic o clic derecho para opciones" FontSize="8.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>

                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="ℹ️ Ver Detalles y Propiedades" Click="MenuProcessDetails_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="🔴 Finalizar Proceso (Kill Task)" Click="MenuProcessKill_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="📂 Abrir Ubicación del Archivo" Click="MenuProcessOpenFolder_Click" Tag="{Binding}"/>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="🔍 Buscar Proceso en Google" Click="MenuProcessSearch_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Id}" FontSize="9.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding MemoryDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding MemoryPercent, StringFormat='{}{0:N1}%'}" FontSize="10" Foreground="{DynamicResource AccentMem}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="ℹ️" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Detalles" Click="BtnProcessDetails_Click" Tag="{Binding}"/>
                                                            <Button Content="✕" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Finalizar Proceso" Click="BtnProcessKill_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 2. ACCELERATORS (GPU / NPU) TAB VIEW -->
                            <Grid Grid.Row="1" Name="ViewAccelerators" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4">
                                        <!-- GPU Diagnostics Deck -->
                                        <Border Background="{DynamicResource BgControl}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{DynamicResource IconGpu}" Fill="{DynamicResource AccentGpu}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                        <TextBlock Name="TxtGpuDeckTitle" Text="PROCESADOR GRÁFICO (GPU / VRAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBlock Name="TxtGpuTabLoad" Text="0.0% Load" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                                </DockPanel>

                                                <TextBlock Name="TxtGpuTabName" Text="Intel(R) Arc(TM) Graphics" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>

                                                <!-- GPU Engine Breakdown -->
                                                <Grid Margin="0,4,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                                        <StackPanel>
                                                            <TextBlock Name="TxtGpu3DTitle" Text="RENDERIZADO 3D" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Name="TxtGpu3D" Text="0.0%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="8,6" Margin="2,0">
                                                        <StackPanel>
                                                            <TextBlock Name="TxtGpuComputeTitle" Text="CÓMPUTO / IA" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Name="TxtGpuCompute" Text="0.0%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="8,6" Margin="2,0">
                                                        <StackPanel>
                                                            <TextBlock Name="TxtGpuVideoTitle" Text="DECODIFICACIÓN VIDEO" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Name="TxtGpuVideo" Text="0.0%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="3" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                                        <StackPanel>
                                                            <TextBlock Name="TxtGpuCopyTitle" Text="MOTOR DE COPIA" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Name="TxtGpuCopy" Text="0.0%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- VRAM Breakdown -->
                                                <DockPanel Margin="0,2,0,2">
                                                    <TextBlock Name="TxtGpuVramTitle" Text="MEMORIA DE VIDEO DEDICADA (VRAM)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Name="TxtGpuVram" Text="0 MB / 2048 MB" DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                                </DockPanel>
                                                <ProgressBar Name="ProgressGpuVram" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentGpu}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- NPU Diagnostics Deck -->
                                        <Border Background="{DynamicResource BgControl}" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{DynamicResource IconNpu}" Fill="{DynamicResource AccentNpu}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                        <TextBlock Name="TxtNpuDeckTitle" Text="UNIDAD DE PROCESAMIENTO NEURAL (NPU / MOTOR IA)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBlock Name="TxtNpuTabStatus" Text="Inactivo (0.0%)" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentNpu}"/>
                                                </DockPanel>

                                                <TextBlock Name="TxtNpuTabName" Text="Intel(R) AI Boost" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                <TextBlock Name="TxtNpuDeckDesc" Text="Acelerador de bajo consumo integrado en el SoC para efectos de cámara de Windows Studio, DirectML e inferencia local de IA." FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                                <DockPanel Margin="0,2,0,2">
                                                    <TextBlock Name="TxtNpuComputeTitle" Text="UTILIZACIÓN DEL MOTOR DE CÓMPUTO NEURAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Name="TxtNpuTabLoad" Text="0.0%" DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource AccentNpu}"/>
                                                </DockPanel>
                                                <ProgressBar Name="ProgressNpuTab" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentNpu}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- 3. SERVICES VIEW -->
                            <Grid Grid.Row="1" Name="ViewServices" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColServiceName" Text="SERVICIO DE WINDOWS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="1" Name="TxtColServiceStatus" Text="ESTADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ListServices">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="6,4" Margin="0,1.5" Tag="{Binding}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="▶️ Iniciar Servicio" Click="MenuServiceStart_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="⏹️ Detener Servicio" Click="MenuServiceStop_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="🔄 Reiniciar Servicio" Click="MenuServiceRestart_Click" Tag="{Binding}"/>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="⚙️ Abrir Consola de Servicios (services.msc)" Click="MenuOpenServices_Click"/>
                                                            <MenuItem Header="🔍 Buscar Servicio en Google" Click="MenuServiceSearch_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="📋 Copiar Nombre" Click="MenuServiceCopy_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="4,0,6,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ServiceName}" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatusOk}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 4. TASKS VIEW -->
                            <Grid Grid.Row="1" Name="ViewTasks" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColTaskName" Text="TAREA PROGRAMADA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="1" Name="TxtColTaskState" Text="ESTADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ListTasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="6,4" Margin="0,1.5" Tag="{Binding}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="▶️ Ejecutar Tarea Ahora" Click="MenuTaskRun_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="⏹️ Detener Tarea" Click="MenuTaskEnd_Click" Tag="{Binding}"/>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="📅 Abrir Programador de Tareas (taskschd.msc)" Click="MenuOpenTaskSchd_Click"/>
                                                            <MenuItem Header="🔍 Buscar Tarea en Google" Click="MenuTaskSearch_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="📋 Copiar Nombre de Tarea" Click="MenuTaskCopy_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="4,0,6,0">
                                                            <TextBlock Text="{Binding TaskName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TaskPath}" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding State}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 5. STARTUP APPS VIEW -->
                            <Grid Grid.Row="1" Name="ViewStartup" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColStartupApp" Text="APLICACIÓN / PROGRAMA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="1" Name="TxtColStartupLocation" Text="ORIGEN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Name="TxtColStartupStatus" Text="ESTADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Name="TxtColStartupActions" Text="ACCIONES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- Startup Apps List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ListStartup">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="6,4" Margin="0,1.5" Tag="{Binding}">
                                                    <Border.ToolTip>
                                                        <ToolTip Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Padding="8">
                                                            <StackPanel MaxWidth="320">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentMem}"/>
                                                                <TextBlock Text="{Binding Publisher, StringFormat='Editor: {0}'}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,3"/>
                                                                <Separator Background="{DynamicResource BorderCard}" Margin="0,1,0,3"/>
                                                                <TextBlock Text="{Binding Location, StringFormat='Origen: {0}'}" FontSize="9.5" Foreground="{DynamicResource TextPrimary}"/>
                                                                <TextBlock Text="{Binding Command, StringFormat='Comando: {0}'}" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                                <TextBlock Text="💡 Clic derecho para opciones" FontSize="8.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>

                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="📂 Abrir Ubicación del Archivo" Click="MenuStartupOpenFolder_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="🔍 Buscar Programa en Google" Click="MenuStartupSearch_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="📋 Copiar Comando / Ruta" Click="MenuStartupCopyCmd_Click" Tag="{Binding}"/>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="⚙️ Abrir Configuración de Inicio de Windows" Click="MenuStartupSettings_Click"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="135"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Column 0: App Name & Subtitle/Publisher -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,6,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Publisher}" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- Column 1: Location Pill Badge -->
                                                        <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Location}" FontSize="8.5" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>

                                                        <!-- Column 2: Status Pill Badge -->
                                                        <Border Grid.Column="2" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatusOk}"/>
                                                        </Border>

                                                        <!-- Column 3: Action Buttons -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Button Content="📂" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Abrir Carpeta" Click="BtnStartupFolder_Click" Tag="{Binding}"/>
                                                            <Button Content="🔍" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Buscar Online" Click="BtnStartupSearch_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 5: MINIMAL STATUS FOOTER (FULL HUD ONLY)                              -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="5" Margin="0,6,0,0" Name="ContainerFooter">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Name="TxtFooterLeft" Text="⚡ Native Zero-Dependency Telemetry" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Name="TxtFooterRight" Text="Direct3D C# P/Invoke • Zero Ring-0 Risk" DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 2. MINI WIDGET VIEW CONTAINER (ACTIVE ONLY IN WIDGET MODE)                -->
            <!-- ========================================================================= -->
            <Border Name="ContainerWidgetView" Style="{DynamicResource WidgetCardStyle}" Visibility="Collapsed" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseDown="Widget_MouseDown" ToolTip="Doble clic para volver al Modo Completo (o clic derecho para opciones)">
                <Border.ContextMenu>
                    <ContextMenu Name="MenuWidgetContext">
                        <MenuItem Name="MenuWidgetRestore" Header="🖥️ Restaurar a Modo Completo" Click="MenuViewFull_Click"/>
                        <MenuItem Name="MenuWidgetHero" Header="📊 Cambiar a Modo Compacto" Click="MenuViewHero_Click"/>
                        <Separator/>
                        <MenuItem Name="MenuWidgetSnap" Header="📍 Acoplar a la Esquina Inferior Derecha" Click="MenuWidgetSnap_Click"/>
                        <MenuItem Name="MenuWidgetPin" Header="📌 Fijar Siempre Visible (Always on Top)" Click="BtnPinTop_Click"/>
                        <Separator/>
                        <MenuItem Name="MenuWidgetClose" Header="❌ Cerrar Monitor" Click="BtnClose_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Widget Caption Line -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Name="ImgWidgetLogo" Width="14" Height="14" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="PC Monitor" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="BtnWidgetPin" Style="{DynamicResource WindowCaptionButtonStyle}" Width="22" Height="20" ToolTip="Fijar Siempre Visible (Always on Top)" Click="BtnPinTop_Click">
                                <Path Name="PathWidgetPin" Data="{DynamicResource IconPin}" Fill="{DynamicResource TextMuted}" Width="8" Height="8" Stretch="Uniform"/>
                            </Button>
                            <Button Name="BtnWidgetExpand" Style="{DynamicResource WindowCaptionButtonStyle}" Width="22" Height="20" ToolTip="Restaurar a Modo Completo (Doble clic)" Click="MenuViewFull_Click">
                                <Path Data="{DynamicResource IconRestore}" Fill="{DynamicResource AccentCpu}" Width="8" Height="8" Stretch="Uniform"/>
                            </Button>
                            <Button Name="BtnWidgetClose" Style="{DynamicResource WindowCloseButtonStyle}" Width="22" Height="20" ToolTip="Cerrar" Click="BtnClose_Click">
                                <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondary}" Width="8" Height="8" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Widget Micro-Meters Grid (CPU, GPU, RAM, NET) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Micro CPU -->
                        <Border Grid.Column="0" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="CPU" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}"/>
                                    <TextBlock Name="TxtWidgetCpu" Text="0%" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetCpu" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentCpu}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Micro GPU -->
                        <Border Grid.Column="1" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="GPU" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                    <TextBlock Name="TxtWidgetGpu" Text="0%" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetGpu" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentGpu}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Micro RAM -->
                        <Border Grid.Column="2" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="RAM" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentMem}"/>
                                    <TextBlock Name="TxtWidgetRam" Text="0%" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetRam" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentMem}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Micro NET -->
                        <Border Grid.Column="3" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="NET" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentNet}"/>
                                    <TextBlock Name="TxtWidgetNet" Text="0K" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetNet" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentNet}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
