<Window x:Class="SimplePCMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple PC Monitor"
        Height="740" Width="1160"
        MinWidth="940" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ContextMenu x:Key="TrayContextMenu" Placement="MousePoint">
            <MenuItem Name="TrayMenuOpen" Header="🖥️ Abrir Simple PC Monitor" FontWeight="Bold" Click="TrayMenuRestore_Click"/>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuPower" Header="⚡ Plan de Energía">
                <MenuItem Name="TrayMenuPlanSaver" Header="🌱 Modo Ahorro (Eco)" Click="BtnPlanSaver_Click"/>
                <MenuItem Name="TrayMenuPlanBalanced" Header="⚖️ Modo Equilibrado (Balanced)" Click="BtnPlanBalanced_Click"/>
                <MenuItem Name="TrayMenuPlanHighPerf" Header="🚀 Modo Rendimiento (Turbo)" Click="BtnPlanHighPerf_Click"/>
            </MenuItem>
            <MenuItem Name="TrayMenuOptimize" Header="🧹 Optimizar Memoria RAM" Click="BtnOptimize_Click"/>
            <MenuItem Name="TrayMenuCleanTemp" Header="🗑️ Limpiar Temporales (%TEMP%)" Click="BtnCleanTemp_Click"/>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuViewModes" Header="📐 Modo de Visualización">
                <MenuItem Header="🖥️ Dashboard Completo" Click="MenuViewFull_Click"/>
                <MenuItem Header="📊 Modo Compacto (Hero)" Click="MenuViewHero_Click"/>
                <MenuItem Header="📌 Mini Widget Flotante" Click="MenuViewWidget_Click"/>
            </MenuItem>
            <MenuItem Name="TrayMenuSettings" Header="⚙️ Preferencias">
                <MenuItem Name="TrayMenuMinToTray" Header="📥 Minimizar a la bandeja" IsCheckable="True" Click="TrayMenuMinToTray_Click"/>
                <MenuItem Name="TrayMenuCloseToTray" Header="❌ Cerrar a la bandeja" IsCheckable="True" Click="TrayMenuCloseToTray_Click"/>
                <MenuItem Name="TrayMenuRunAtStartup" Header="🚀 Iniciar con Windows" IsCheckable="True" Click="TrayMenuRunAtStartup_Click"/>
                <MenuItem Name="TrayMenuAlwaysOnTop" Header="📌 Siempre visible" IsCheckable="True" Click="BtnPinTop_Click"/>
            </MenuItem>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuTools" Header="🛠️ Herramientas de Windows">
                <MenuItem Header="📊 Administrador de Tareas" Click="BtnTaskMgr_Click"/>
                <MenuItem Header="📈 Monitor de Recursos" Click="BtnResMon_Click"/>
                <MenuItem Header="⚙️ Servicios de Windows" Click="MenuOpenServices_Click"/>
            </MenuItem>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuExit" Header="🚪 Salir de Simple PC Monitor" Click="TrayMenuExit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Outer Card with Smooth Acrylic/Glass Elevation -->
    <Border Name="OuterBorder" Background="{DynamicResource BgApp}" CornerRadius="14" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.32" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- ========================================================================= -->
            <!-- 1. FULL HUD & HERO VIEW CONTAINER                                         -->
            <!-- ========================================================================= -->
            <Grid Name="ContainerMainView" Margin="14" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Caption TitleBar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Streamlined Command Ribbon -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: 6 Bento Hardware Metric Cards (CPU, GPU, NPU, RAM, Disk, Net) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Live Historical Wave Sparklines -->
                    <RowDefinition Height="Auto" Name="RowLiveWaves"/>
                    <!-- Row 4: Deep-Dive Workspace Area (Full HUD only) -->
                    <RowDefinition Height="*" Name="RowDeepDive"/>
                    <!-- Row 5: Minimal Status Footer (Full HUD only) -->
                    <RowDefinition Height="Auto" Name="RowFooter"/>
                </Grid.RowDefinitions>

                <!-- ========================================================================= -->
                <!-- ROW 0: WINDOW TITLE BAR                                                   -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="0" Margin="0,0,0,8" Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Branding & Status Badges -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Name="ImgAppLogo" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Simple PC Monitor" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        
                        <!-- Compact Hardware Specs Badge with full ToolTip -->
                        <Border Name="BorderHwSummary" Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" ToolTip="Especificaciones de hardware del equipo">
                            <TextBlock Name="TxtHwSummaryBadge" Text="💻 System Hardware" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>

                        <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,1.5" Margin="5,0,0,0">
                            <TextBlock Name="TxtCpuCoresBadge" Text="16 Cores" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>
                        
                        <Border Name="BorderUptime" Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,1.5" Margin="5,0,0,0" ToolTip="Tiempo continuo que la computadora lleva encendida desde el último reinicio">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️ " FontSize="8.5" VerticalAlignment="Center"/>
                                <TextBlock Name="TxtUptime" Text="Uptime: 0d 0h" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Alert for Unresponsive Processes -->
                        <Border Name="BorderUnresponsiveAlert" Background="#33FF4444" BorderBrush="#88FF4444" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="TxtUnresponsiveAlert" Text="⚠️ 1 Proceso Colgado" FontSize="9.5" FontWeight="Bold" Foreground="#FFFF5555" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Name="BtnRescueUnresponsive" Content="Rescatar" Style="{DynamicResource PillActionButtonStyle}" Height="18" Padding="4,0" FontSize="8.5" Click="BtnRescueUnresponsive_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Draggable Space -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Pinned Window Caption Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnPinTop" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Pin Window on Top (Always on Top)" Click="BtnPinTop_Click">
                            <Path Name="PathPin" Data="{DynamicResource IconPin}" Fill="{DynamicResource TextMuted}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnMinimize" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Minimize" Click="BtnMinimize_Click">
                            <Path Data="{DynamicResource IconMinimize}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnMaximize" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Maximize / Restore" Click="BtnMaximize_Click">
                            <Path Name="PathMaximize" Data="{DynamicResource IconMaximize}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnClose" Style="{DynamicResource WindowCloseButtonStyle}" ToolTip="Close" Click="BtnClose_Click">
                            <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 1: STREAMLINED RESPONSIVE COMMAND RIBBON                              -->
                <!-- ========================================================================= -->
                <DockPanel Grid.Row="1" Margin="0,0,0,8" Name="ContainerRibbon" LastChildFill="True">
                    <!-- Right: Tools Dropdown, View Mode, Theme, Language & Interval (Docked Right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tools Split Dropdown -->
                        <Button Name="BtnToolsMenu" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Windows Diagnostic Tools" Click="BtnToolsMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconLaunch}" Fill="{DynamicResource TextSecondary}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtBtnTools" Text="Herramientas ▾"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuWindowsTools">
                                    <MenuItem Name="MenuToolsTaskMgr" Header="📊 Administrador de Tareas (Task Manager)" Click="BtnTaskMgr_Click"/>
                                    <MenuItem Name="MenuToolsResMon" Header="📈 Monitor de Recursos (Resmon)" Click="BtnResMon_Click"/>
                                    <MenuItem Name="MenuToolsStorageSense" Header="🛡️ Sensor de Almacenamiento (Storage Sense)" Click="BtnPCMgr_Click"/>
                                    <MenuItem Name="MenuToolsServices" Header="⚙️ Gestión de Servicios de Windows" Click="MenuOpenServices_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Border Width="1" Height="14" Background="{DynamicResource BorderCard}" Margin="3,0"/>

                        <!-- View Mode Switcher Dropdown -->
                        <Button Name="BtnToggleView" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Modo de Vista (Completo / Compacto / Mini Widget)" Click="BtnToggleView_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="TxtViewMode" Text="Completo" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=" ▾" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuViewModes">
                                    <MenuItem Name="MenuViewFullItem" Header="🖥️ Modo Completo (Dashboard + Procesos)" Click="MenuViewFull_Click"/>
                                    <MenuItem Name="MenuViewHeroItem" Header="📊 Modo Compacto (Tarjetas y Ondas)" Click="MenuViewHero_Click"/>
                                    <MenuItem Name="MenuViewWidgetItem" Header="📌 Modo Mini Widget (Barra Flotante)" Click="MenuViewWidget_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Theme Switcher Dropdown -->
                        <Button Name="BtnToggleTheme" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Tema Visual (Dark, Light, Neon, Rose)" Click="BtnToggleTheme_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconTheme}" Fill="{DynamicResource AccentMem}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtCurrentTheme" Text="Dark" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=" ▾" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuThemes">
                                    <MenuItem Name="MenuThemeDarkItem" Header="🌙 Pastel Dark (Oscuro)" Click="MenuThemeDark_Click"/>
                                    <MenuItem Name="MenuThemeLightItem" Header="☀️ Pastel Light (Claro)" Click="MenuThemeLight_Click"/>
                                    <MenuItem Name="MenuThemeNeonItem" Header="⚡ Pastel Neon (Cyberpunk)" Click="MenuThemeNeon_Click"/>
                                    <MenuItem Name="MenuThemeRoseItem" Header="🌸 Pastel Rose (Rosa Pastel)" Click="MenuThemeRose_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Language Switcher Dropdown (ES / EN) -->
                        <Button Name="BtnToggleLang" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Idioma / Change Language" Click="BtnToggleLang_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="TxtCurrentLang" Text="ES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=" ▾" FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuLanguages">
                                    <MenuItem Header="Español" Click="MenuLangEs_Click"/>
                                    <MenuItem Header="English" Click="MenuLangEn_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Refresh Interval (3s / 5s) -->
                        <Button Name="BtnToggleInterval" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cambiar Intervalo de Refresco (3s / 5s)" Click="BtnToggleInterval_Click">
                            <TextBlock Name="TxtInterval" Text="3s" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>

                        <Border Width="1" Height="14" Background="{DynamicResource BorderCard}" Margin="3,0"/>

                        <!-- Options & Tray Settings Dropdown -->
                        <Button Name="BtnSettingsMenu" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Configuración del Sistema y Bandeja" Click="BtnSettingsMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconSettings}" Fill="{DynamicResource TextSecondary}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtBtnSettings" Text="Opciones ▾" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuAppSettings">
                                    <MenuItem Name="MenuSettingMinToTray" Header="📥 Minimizar a la bandeja" IsCheckable="True" Click="TrayMenuMinToTray_Click"/>
                                    <MenuItem Name="MenuSettingCloseToTray" Header="❌ Cerrar a la bandeja" IsCheckable="True" Click="TrayMenuCloseToTray_Click"/>
                                    <MenuItem Name="MenuSettingStartup" Header="🚀 Iniciar con Windows" IsCheckable="True" Click="TrayMenuRunAtStartup_Click"/>
                                    <Separator Margin="0,3"/>
                                    <MenuItem Name="MenuSettingAlwaysOnTop" Header="📌 Siempre visible" IsCheckable="True" Click="BtnPinTop_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- Left: Core Performance Actions & Segmented Power Plan (Fills remaining horizontal space) -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnTurboMode" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="1-Clic: Activa Modo Turbo (Alto Rendimiento + Purga de RAM)" Click="BtnTurboMode_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconPower}" Fill="{DynamicResource AccentCpu}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtBtnTurboMode" Text="Modo Turbo" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnOptimize" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Reducir conjunto de trabajo y optimizar RAM" Click="BtnOptimize_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconPower}" Fill="{DynamicResource AccentMem}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtBtnOptimize" Text="Optimizar RAM"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnCleanTemp" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Limpieza profunda y segura de temporales, Windows Update y caché web" Click="BtnCleanTemp_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconBroom}" Fill="{DynamicResource AccentDisk}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtBtnCleanTemp" Text="Limpiar Temp"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnFlushDns" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Vaciar caché DNS de Windows (DnsFlushResolverCache)" Click="BtnFlushDns_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconNetwork}" Fill="{DynamicResource AccentNet}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtBtnFlushDns" Text="Vaciar DNS"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnSnapshotTop" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Copiar informe de diagnóstico (Markdown) al portapapeles" Click="BtnSnapshot_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconCamera}" Fill="{DynamicResource TextSecondary}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Name="TxtBtnSnapshot" Text="Captura"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="14" Background="{DynamicResource BorderCard}" Margin="4,0"/>

                        <!-- Segmented Power Plan Selector -->
                        <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="2,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="8.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="3,0,2,0"/>
                                <Button Name="BtnPlanSaver" Content="Eco" Style="{DynamicResource SegmentedPillButtonStyle}" ToolTip="Cambiar al plan de ahorro de energía" Click="BtnPlanSaver_Click"/>
                                <Button Name="BtnPlanBalanced" Content="Balanced" Style="{DynamicResource SegmentedPillButtonStyle}" ToolTip="Cambiar al plan equilibrado de Windows" Click="BtnPlanBalanced_Click"/>
                                <Button Name="BtnPlanHighPerf" Content="Turbo" Style="{DynamicResource SegmentedPillButtonStyle}" ToolTip="Cambiar al plan de alto rendimiento" Click="BtnPlanHighPerf_Click"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </DockPanel>

                <!-- ========================================================================= -->
                <!-- ROW 2: 6 BENTO HARDWARE METRIC CARDS                                      -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="2" Margin="-3,0,-3,6" Name="ContainerHeroGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. CPU CARD -->
                    <Border Name="CardCpu" Grid.Column="0" Style="{DynamicResource BentoCardStyle}" Cursor="Hand" ToolTip="Clic para ver y ordenar procesos por mayor consumo de CPU" MouseLeftButtonDown="CardCpu_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconCpu}" Fill="{DynamicResource AccentCpu}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardCpuTitle" Text="PROCESADOR" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtCpuCores" Text="16 Cores" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtCpuVal" Text="0.0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressCpu" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentCpu}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtCpuSub" Text="Direct Win32 Kernel" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 2. GPU CARD -->
                    <Border Name="CardGpu" Grid.Column="1" Style="{DynamicResource BentoCardStyle}" Cursor="Hand" ToolTip="Clic para ver pestaña de Aceleradores Gráficos y Motores 3D" MouseLeftButtonDown="CardGpu_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconGpu}" Fill="{DynamicResource AccentGpu}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardGpuTitle" Text="GRÁFICOS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtGpuTypeBadge" Text="3D Engine" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtGpuVal" Text="0.0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressGpu" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentGpu}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtGpuSub" Text="Intel Arc Graphics" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 3. NPU (AI ACCELERATOR) CARD (Dynamic visibility) -->
                    <Border Grid.Column="2" Style="{DynamicResource BentoCardStyle}" Name="CardNpu" Visibility="Collapsed" Cursor="Hand" ToolTip="Clic para ver diagnóstico del motor NPU" MouseLeftButtonDown="CardNpu_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconNpu}" Fill="{DynamicResource AccentNpu}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardNpuTitle" Text="NPU (IA)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtNpuStatusBadge" Text="Idle" DockPanel.Dock="Right" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentNpu}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtNpuVal" Text="0.0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressNpu" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentNpu}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtNpuSub" Text="Intel AI Boost" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 4. MEMORY (RAM) CARD -->
                    <Border Name="CardRam" Grid.Column="3" Style="{DynamicResource BentoCardStyle}" Cursor="Hand" ToolTip="Clic para ver y ordenar procesos por mayor consumo de memoria RAM" MouseLeftButtonDown="CardRam_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconRam}" Fill="{DynamicResource AccentMem}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardRamTitle" Text="MEMORIA RAM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtRamTotalBadge" Text="16 GB" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtRamVal" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressRam" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentMem}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtRamSub" Text="0 / 16 GB Used" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 5. STORAGE DISK CARD -->
                    <Border Name="CardDisk" Grid.Column="4" Style="{DynamicResource BentoCardStyle}" Cursor="Hand" ToolTip="Clic para ver unidades de almacenamiento y opciones de limpieza" MouseLeftButtonDown="CardDisk_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconDisk}" Fill="{DynamicResource AccentDisk}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardDiskTitle" Text="ALMACENAMIENTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtDiskTotalBadge" Text="C:" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtDiskVal" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressDisk" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentDisk}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtDiskSub" Text="0 GB Free" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 6. NETWORK CARD -->
                    <Border Name="CardNet" Grid.Column="5" Style="{DynamicResource BentoCardStyle}" Cursor="Hand" ToolTip="Clic para comprobar latencia y vaciar DNS" MouseLeftButtonDown="CardNet_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconNetwork}" Fill="{DynamicResource AccentNet}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Name="TxtCardNetTitle" Text="RED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtNetPingBadge" Text="-- ms" DockPanel.Dock="Right" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentNet}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Name="TxtNetVal" Text="0 KB/s" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1"/>

                            <ProgressBar Grid.Row="2" Name="ProgressNet" Value="0" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentNet}" Margin="0,2,0,4"/>

                            <TextBlock Grid.Row="3" Name="TxtNetSub" Text="↓ 0  ↑ 0 KB/s" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 3: LIVE REAL-TIME WAVE SPARKLINE CHARTS                               -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="3" Margin="-3,0,-3,6" Name="ContainerLiveWaves">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU 30s Sparkline -->
                    <Border Grid.Column="0" Style="{DynamicResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Name="TxtWaveCpuTitle" Text="CARGA DE CPU (ONDA 30s EN VIVO)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Name="TxtCpuLivePeak" Text="Peak: 0%" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource AccentCpu}"/>
                            </DockPanel>
                            <Canvas Grid.Row="1" Name="CanvasCpuGraph" Height="50" ClipToBounds="True" Background="Transparent">
                                <Polygon Name="PolyCpuArea" Fill="{DynamicResource AccentCpuAlpha}"/>
                                <Polyline Name="LineCpuStroke" Stroke="{DynamicResource AccentCpu}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Network / GPU 30s Sparkline -->
                    <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Name="TxtWaveNetTitle" Text="TRÁFICO DE RED (ONDA 30s EN VIVO)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Name="TxtNetLivePeak" Text="Peak: 0 KB/s" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource AccentNet}"/>
                            </DockPanel>
                            <Canvas Grid.Row="1" Name="CanvasNetGraph" Height="50" ClipToBounds="True" Background="Transparent">
                                <Polygon Name="PolyNetArea" Fill="{DynamicResource AccentNetAlpha}"/>
                                <Polyline Name="LineNetStroke" Stroke="{DynamicResource AccentNet}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- ROW 4: FULL-WIDTH INTERACTIVE DEEP DIVE WORKSPACE (NO 270px STATIC COLUMN) -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="4" Margin="-3,0" Name="ContainerDeepDive">
                    <Border Style="{DynamicResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Clean Tab Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="TabBtnProcesses" Content="&#xE9D9; Procesos" Style="{DynamicResource ActiveTabHeaderButtonStyle}" Click="TabBtnProcesses_Click"/>
                                    <Button Name="TabBtnAiAgents" Content="&#xE99A; Agentes IA &amp; MCP" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnAiAgents_Click"/>
                                    <Button Name="TabBtnAccelerators" Content="&#xE9F5; Aceleradores (GPU/NPU)" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnAccelerators_Click"/>
                                    <Button Name="TabBtnServices" Content="&#xE713; Servicios" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnServices_Click"/>
                                    <Button Name="TabBtnTasks" Content="&#xE823; Tareas Programadas" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnTasks_Click"/>
                                    <Button Name="TabBtnStartup" Content="&#xE7BE; Apps de Inicio" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnStartup_Click"/>
                                    <Button Name="TabBtnDrives" Content="&#xEDA2; Discos &amp; Almacenamiento" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnDrives_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 1. TOP PROCESSES VIEW WITH REAL-TIME SEARCH & ACTIONS -->
                            <Grid Grid.Row="1" Name="ViewProcesses" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <!-- Row 0: Search & Quick Sorting Filter Toolbar -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 1: Table Header -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 2: Process List (Virtualizing) -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Process Toolbar: Search Box & Sort Switches -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Name="BtnSortCpu" Content="&#xE9F5; CPU %" Style="{DynamicResource PillActionButtonStyle}" Margin="0,0,4,0" ToolTip="Ordenar por mayor consumo de CPU" Click="BtnSortCpu_Click"/>
                                        <Button Name="BtnSortRam" Content="&#xE950; RAM MB" Style="{DynamicResource PillActionButtonStyle}" Margin="0,0,4,0" ToolTip="Ordenar por mayor consumo de memoria RAM" Click="BtnSortRam_Click"/>
                                        <Button Name="BtnResumeAll" Content="&#xE768; Reanudar Todos" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Reanudar todos los procesos suspendidos" Click="BtnResumeAll_Click"/>
                                    </StackPanel>

                                    <!-- Search Input with placeholder -->
                                    <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                        <Grid>
                                            <TextBox Name="TxtSearchProcess" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" FontSize="10.5" TextChanged="TxtSearchProcess_TextChanged" VerticalAlignment="Center"/>
                                            <TextBlock Name="TxtSearchPlaceholder" Text="&#xE721; Buscar proceso por nombre o PID..." FontSize="9.5" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DockPanel>

                                <!-- Table Header -->
                                <Grid Grid.Row="1" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="135"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColPid" Text="PID" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Name="TxtColApp" Text="APLICACIÓN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="2" Name="TxtColCpu" Text="CPU %" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Name="TxtColWorkingSet" Text="MEMORIA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Name="TxtColRamPercent" Text="% RAM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Name="TxtColState" Text="ESTADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Name="TxtColActions" Text="ACCIONES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- Process List (Virtualizing & Anti-Jank) -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ListProcesses" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3.5" Margin="0,1.5" Cursor="Hand" MouseLeftButtonDown="ProcessRow_MouseLeftButtonDown" Tag="{Binding}">
                                                    <Border.ToolTip>
                                                        <ToolTip Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Padding="8">
                                                            <StackPanel MaxWidth="320">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentMem}"/>
                                                                <TextBlock Text="{Binding SubtitleText}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,3"/>
                                                                <Separator Background="{DynamicResource BorderCard}" Margin="0,1,0,3"/>
                                                                <TextBlock Text="{Binding CpuDisplay, StringFormat='CPU: {0}'}" FontSize="9.5" Foreground="{DynamicResource AccentCpu}"/>
                                                                <TextBlock Text="{Binding MemoryDisplay, StringFormat='RAM: {0}'}" FontSize="9.5" Foreground="{DynamicResource TextPrimary}"/>
                                                                <TextBlock Text="{Binding PriorityClass, StringFormat='Prioridad: {0}'}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding ExecutablePath, StringFormat='Path: {0}'}" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                                <TextBlock Text="💡 Clic derecho para opciones completas" FontSize="8.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>

                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="ℹ️ Ver Detalles y Propiedades" Click="MenuProcessDetails_Click" Tag="{Binding}"/>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="⏸ Pausar Proceso (Suspend)" Click="MenuProcessSuspend_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="▶ Reanudar Proceso (Resume)" Click="MenuProcessResume_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="⚡ Prioridad de CPU">
                                                                <MenuItem Header="🚀 Tiempo Real (RealTime)" Click="MenuProcessPriority_Click" Tag="RealTime"/>
                                                                <MenuItem Header="🔥 Alta (High)" Click="MenuProcessPriority_Click" Tag="High"/>
                                                                <MenuItem Header="⬆️ Por Encima de Normal (AboveNormal)" Click="MenuProcessPriority_Click" Tag="AboveNormal"/>
                                                                <MenuItem Header="⚖️ Normal" Click="MenuProcessPriority_Click" Tag="Normal"/>
                                                                <MenuItem Header="⬇️ Por Debajo de Normal (BelowNormal)" Click="MenuProcessPriority_Click" Tag="BelowNormal"/>
                                                                <MenuItem Header="🌱 Baja (Idle)" Click="MenuProcessPriority_Click" Tag="Idle"/>
                                                            </MenuItem>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="🔴 Finalizar Proceso (Kill Task)" Click="MenuProcessKill_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="📂 Abrir Ubicación del Archivo" Click="MenuProcessOpenFolder_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="🔍 Buscar Proceso en Google" Click="MenuProcessSearch_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="75"/>
                                                            <ColumnDefinition Width="135"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- PID -->
                                                        <TextBlock Text="{Binding Id}" FontSize="9.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>

                                                        <!-- Name & Publisher -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- CPU % -->
                                                        <TextBlock Grid.Column="2" Text="{Binding CpuDisplay}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        <!-- RAM MB -->
                                                        <TextBlock Grid.Column="3" Text="{Binding MemoryDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        <!-- RAM % -->
                                                        <TextBlock Grid.Column="4" Text="{Binding MemoryPercent, StringFormat='{}{0:N1}%'}" FontSize="10" Foreground="{DynamicResource AccentMem}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        <!-- Status Badge (Responding vs Hang) -->
                                                        <Border Grid.Column="5" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource StatusOk}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="● Activo"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsResponding}" Value="False">
                                                                                <Setter Property="Text" Value="● Colgado"/>
                                                                                <Setter Property="Foreground" Value="#FFFF5555"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Direct Action Buttons -->
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Style="{DynamicResource PillActionButtonStyle}" ToolTip="Pausar / Reanudar Proceso" Click="BtnProcessSuspendToggle_Click" Tag="{Binding}" Width="24" Height="20" Padding="0">
                                                                <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Style="{DynamicResource PillActionButtonStyle}" ToolTip="Detalles del Proceso" Click="BtnProcessDetails_Click" Tag="{Binding}" Width="24" Height="20" Padding="0" Margin="2,0">
                                                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Style="{DynamicResource PillActionButtonStyle}" ToolTip="Finalizar Proceso" Click="BtnProcessKill_Click" Tag="{Binding}" Width="24" Height="20" Padding="0">
                                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 2. AI AGENTS & MCP ECOSYSTEM TAB VIEW -->
                            <Grid Grid.Row="1" Name="ViewAiAgents" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar: Aggregated Metrics & Clean Orphaned -->
                                <DockPanel Grid.Row="0" Margin="4,0,4,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BgCard}" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🤖 Sesiones Detectadas: " FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Name="TxtAiSessionsCount" Text="0" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgCard}" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔌 Servidores MCP: " FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Name="TxtAiMcpCount" Text="0" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgCard}" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🧠 RAM Consolidada: " FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Name="TxtAiTotalRam" Text="0.0 MB" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentMem}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Name="BtnRefreshAiAgents" Content="🔄 Actualizar" Style="{DynamicResource PillActionButtonStyle}" Margin="0,0,4,0" ToolTip="Escanear árbol de procesos Win32 de agentes de IA" Click="BtnRefreshAiAgents_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Sessions List (Hierarchical Bento Style) -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="2">
                                        <!-- Empty state placeholder when no agents running -->
                                        <Border Name="BorderNoAiAgents" Background="{DynamicResource BgControl}" CornerRadius="8" Padding="20,16" Margin="0,4" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🤖 Cero Agentes IA o Servidores MCP Activos" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Cuando ejecutes herramientas como Claude Code CLI, Gemini CLI, Aider, Codex o Cursor, sus procesos y servidores MCP hijos aparecerán aquí automáticamente." FontSize="9.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl Name="ListAiSessions">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BgControl}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Session Header: Agent Name, PID, Status Badge, Resources & Actions -->
                                                            <DockPanel Grid.Row="0">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="🤖 " FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding AgentName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                                    <Border Background="{DynamicResource BgCard}" CornerRadius="4" Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ParentPid, StringFormat='PID: {0}'}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusBadgeColor}"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Right Actions -->
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="RAM Total: " FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                                                            <TextBlock Text="{Binding TotalMemoryDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentMem}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="CPU: " FontSize="9.5" Foreground="{DynamicResource TextMuted}"/>
                                                                            <TextBlock Text="{Binding TotalCpuDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Button Content="⏸ Pausar" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Pausar / Reanudar sesión y servidores MCP" Click="BtnAiAgentSuspendToggle_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                                                    <Button Content="🛑 Cierre Ordenado" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Cierre en 2 fases: solicita cierre ordenado y verifica minimizado a bandeja" Click="BtnAiAgentCloseGraceful_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                                                    <Button Content="⚡ Terminar Árbol" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Terminación forzada en orden topológico inverso (evita zombis)" Click="BtnAiAgentKillTree_Click" Tag="{Binding}"/>
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <!-- Session Subtitle Details & Expand Toggle -->
                                                            <DockPanel Grid.Row="1" Margin="2,4,0,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource BgCard}" CornerRadius="4" Padding="5,1.5" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding SessionContext}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentCpu}" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding ChildProcessCount, StringFormat='{}Subprocesos: {0}'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding McpServersCount, StringFormat='{} · MCP: {0}'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StartTimeDisplay, StringFormat='{}Iniciado: {0}'}" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <Button Content="{Binding ExpandToggleText}" Style="{DynamicResource PillActionButtonStyle}" Padding="8,1.5" FontSize="8.5" ToolTip="Mostrar u ocultar la lista de subprocesos" Click="BtnToggleAiSessionExpand_Click" Tag="{Binding}"/>
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <!-- Child Processes List (Collapsible, Natural Flow without Nested ScrollViewer) -->
                                                            <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="6,4" Margin="0,2,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <ItemsControl ItemsSource="{Binding ChildProcesses}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <DockPanel Margin="0,2" ToolTip="{Binding TooltipText}">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text=" ↳ " FontSize="9.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding ProcessName}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
