                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="BtnWidgetPin" Style="{DynamicResource WindowCaptionButtonStyle}" Width="22" Height="20" ToolTip="Fijar Siempre Visible (Always on Top)" Click="BtnPinTop_Click">
