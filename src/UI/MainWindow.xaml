                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{DynamicResource IconDisk}" Fill="{DynamicResource AccentDisk}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                                                    <TextBlock Text="{Binding VolumeLabel}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"/>
                                                                    <Border Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding DriveFormat}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FreeGB, StringFormat='{}{0:N1} GB Libres'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
