                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- 3. SERVICES VIEW WITH QUICK TOGGLE ACTIONS -->
                            <Grid Grid.Row="1" Name="ViewServices" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColServiceName" Text="SERVICIO DE WINDOWS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="1" Name="TxtColServiceStatus" Text="ESTADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="ACCIONES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ListServices">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="6,4" Margin="0,1.5" Tag="{Binding}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="▶️ Iniciar Servicio" Click="MenuServiceStart_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="⏹️ Detener Servicio" Click="MenuServiceStop_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="🔄 Reiniciar Servicio" Click="MenuServiceRestart_Click" Tag="{Binding}"/>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="⚙️ Abrir Consola de Servicios (services.msc)" Click="MenuOpenServices_Click"/>
                                                            <MenuItem Header="🔍 Buscar Servicio en Google" Click="MenuServiceSearch_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="📋 Copiar Nombre" Click="MenuServiceCopy_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="4,0,6,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ServiceName}" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatusOk}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="▶" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Iniciar Servicio" Click="BtnServiceStart_Click" Tag="{Binding}"/>
                                                            <Button Content="⏹" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Detener Servicio" Click="BtnServiceStop_Click" Tag="{Binding}"/>
                                                            <Button Content="🔄" Style="{DynamicResource PillActionButtonStyle}" ToolTip="Reiniciar Servicio" Click="BtnServiceRestart_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 4. TASKS VIEW -->
                            <Grid Grid.Row="1" Name="ViewTasks" Visibility="Collapsed">
