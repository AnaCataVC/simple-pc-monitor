<Window x:Class="SystemCoreMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SystemCoreMonitor.ViewModels"
        xmlns:views="clr-namespace:SystemCoreMonitor.Views"
        Title="System Core Monitor"
        Height="760" Width="1200"
        MinWidth="960" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- DataTemplates for MVVM Navigation -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
            <views:ProcessesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiAgentsViewModel}">
            <views:AiAgentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcceleratorsViewModel}">
            <views:AcceleratorsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}">
            <views:StorageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <ContextMenu x:Key="TrayContextMenu" Placement="MousePoint">
            <MenuItem Name="TrayMenuOpen" Header="🖥️ Abrir System Core Monitor" FontWeight="Bold" Click="TrayMenuRestore_Click"/>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuPower" Header="⚡ Plan de Energía">
                <MenuItem Name="TrayMenuPlanSaver" Header="🌱 Modo Ahorro (Eco)" Click="BtnPlanSaver_Click"/>
                <MenuItem Name="TrayMenuPlanBalanced" Header="⚖️ Modo Equilibrado (Balanced)" Click="BtnPlanBalanced_Click"/>
                <MenuItem Name="TrayMenuPlanHighPerf" Header="🚀 Modo Rendimiento (Turbo)" Click="BtnPlanHighPerf_Click"/>
            </MenuItem>
            <MenuItem Name="TrayMenuOptimize" Header="🧹 Optimizar Memoria RAM" Click="BtnOptimize_Click"/>
            <MenuItem Name="TrayMenuCleanTemp" Header="🗑️ Limpiar Temporales (%TEMP%)" Click="BtnCleanTemp_Click"/>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuViewModes" Header="📐 Modo de Visualización">
                <MenuItem Header="🖥️ Dashboard Completo" Click="MenuViewFull_Click"/>
                <MenuItem Header="📌 Mini Widget Flotante" Click="MenuViewWidget_Click"/>
            </MenuItem>
            <MenuItem Name="TrayMenuSettings" Header="⚙️ Preferencias">
                <MenuItem Name="TrayMenuMinToTray" Header="📥 Minimizar a la bandeja" IsCheckable="True" Click="TrayMenuMinToTray_Click"/>
                <MenuItem Name="TrayMenuCloseToTray" Header="❌ Cerrar a la bandeja" IsCheckable="True" Click="TrayMenuCloseToTray_Click"/>
                <MenuItem Name="TrayMenuRunAtStartup" Header="🚀 Iniciar con Windows" IsCheckable="True" Click="TrayMenuRunAtStartup_Click"/>
                <MenuItem Name="TrayMenuAlwaysOnTop" Header="📌 Siempre visible" IsCheckable="True" Click="BtnPinTop_Click"/>
            </MenuItem>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuTools" Header="🛠️ Herramientas de Windows">
                <MenuItem Header="📊 Administrador de Tareas" Click="BtnTaskMgr_Click"/>
                <MenuItem Header="📈 Monitor de Recursos" Click="BtnResMon_Click"/>
                <MenuItem Header="⚙️ Servicios de Windows" Click="MenuOpenServices_Click"/>
            </MenuItem>
            <Separator Margin="0,3"/>
            <MenuItem Name="TrayMenuExit" Header="🚪 Salir de System Core Monitor" Click="TrayMenuExit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Outer Window Chrome with Elevation -->
    <Border Name="OuterBorder" Background="{DynamicResource BgApp}" CornerRadius="14" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- 1. FULL HUD VIEW CONTAINER -->
            <Grid Name="ContainerMainView" Margin="14" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: WINDOW TITLE BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,10" Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Branding & Status Badges -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Name="ImgAppLogo" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="System Core Monitor" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                        <Border Name="BorderHwSummary" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="9,4" Margin="10,0,0,0">
                            <TextBlock Name="TxtHwSummaryBadge" Text="💻 System Hardware" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>

                        <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="9,4" Margin="6,0,0,0">
                            <TextBlock Name="TxtCpuCoresBadge" Text="16 Cores" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>

                        <Border Name="BorderUptime" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="9,4" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️ " FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Name="TxtUptime" Text="Uptime: 0d 0h" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Draggable Space -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Window Caption Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnPinTop" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Pin Window on Top" Click="BtnPinTop_Click">
                            <Path Name="PathPin" Data="{DynamicResource IconPin}" Fill="{DynamicResource TextMuted}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnMinimize" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Minimize" Click="BtnMinimize_Click">
                            <Path Data="{DynamicResource IconMinimize}" Fill="{DynamicResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnMaximize" Style="{DynamicResource WindowCaptionButtonStyle}" ToolTip="Maximize / Restore" Click="BtnMaximize_Click">
                            <Path Name="PathMaximize" Data="{DynamicResource IconMaximize}" Fill="{DynamicResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Name="BtnClose" Style="{DynamicResource WindowCloseButtonStyle}" ToolTip="Close" Click="BtnClose_Click">
                            <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: MAIN BODY (SIDEBAR + CONTENT) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Navigation with Larger Icons & Typography -->
                    <Border Grid.Column="0" Style="{StaticResource BentoCardStyle}" Padding="6,8" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding NavigationItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding ViewModelType}"
                                                    Margin="2,2">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                                        <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BgControlActive}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentCpu}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{Binding IconGeometry}" 
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                          Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Background="{DynamicResource BorderCard}" Margin="6,12"/>

                                <!-- View Mode Switcher in Sidebar -->
                                <TextBlock Text="{Binding WindowModesHeader}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6"/>
                                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="MenuViewWidget_Click" Margin="2,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌 " FontSize="15" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding ViewModeWidgetText}" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Dynamic View Container -->
                    <Border Grid.Column="1" Background="Transparent">
                        <ContentControl Content="{Binding CurrentViewModel}"/>
                    </Border>
                </Grid>

                <!-- ROW 2: ACTION STATUS FOOTER -->
                <Grid Grid.Row="2" Margin="0,8,0,0" Name="ContainerFooter">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Name="TxtStatusNotification" Text="⚡ Telemetría Win32 .NET 9 Activa • 0% CPU Overhead" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Name="TxtFooterRight" Text="Direct3D C# P/Invoke • Pure BCL Standalone" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- PROMINENT FLOATING TOAST BANNER -->
                <Border Name="ToastOverlayBanner"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,32"
                        CornerRadius="20"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource AccentCpu}"
                        BorderThickness="1.5"
                        Padding="18,10"
                        Visibility="Collapsed"
                        Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Name="ToastStatusIcon" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" Fill="{DynamicResource AccentCpu}" Data="{DynamicResource IconSync}" VerticalAlignment="Center"/>
                        <TextBlock Name="ToastStatusText" Text="Acción en progreso..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. MINI WIDGET VIEW CONTAINER (ACTIVE ONLY IN WIDGET MODE) -->
            <Grid Name="ContainerWidgetView" Visibility="Collapsed" Margin="8,4"
                  MouseLeftButtonDown="Widget_MouseLeftButtonDown">
                <Grid.ContextMenu>
                    <ContextMenu Name="MenuWidgetContext">
                        <MenuItem Name="MenuWidgetRestore" Header="🖥️ Restaurar Dashboard" Click="MenuViewFull_Click"/>
                        <Separator/>
                        <MenuItem Name="MenuWidgetSnap" Header="📍 Acoplar a la Esquina Inferior Derecha" Click="MenuWidgetSnap_Click"/>
                        <MenuItem Name="MenuWidgetPin" Header="📌 Fijar Siempre Visible (Always on Top)" Click="BtnPinTop_Click"/>
                        <Separator/>
                        <MenuItem Name="MenuWidgetClose" Header="❌ Cerrar Monitor" Click="BtnClose_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Name="ImgWidgetLogo" Width="15" Height="15" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Core Monitor" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="BtnWidgetPin" Style="{DynamicResource WindowCaptionButtonStyle}" Width="22" Height="20" Click="BtnPinTop_Click" ToolTip="Siempre Visible (Always on Top)">
                                <Path Name="PathWidgetPin" Data="{DynamicResource IconPin}" Fill="{DynamicResource TextMuted}" Width="9" Height="9" Stretch="Uniform"/>
                            </Button>
                            <Button Name="BtnWidgetExpand" Style="{DynamicResource WindowCaptionButtonStyle}" Width="22" Height="20" Click="MenuViewFull_Click" ToolTip="Restaurar Dashboard Completo">
                                <Path Data="{DynamicResource IconRestore}" Fill="{DynamicResource AccentCpu}" Width="9" Height="9" Stretch="Uniform"/>
                            </Button>
                            <Button Name="BtnWidgetClose" Style="{DynamicResource WindowCloseButtonStyle}" Width="22" Height="20" Click="BtnClose_Click" ToolTip="Cerrar">
                                <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondary}" Width="9" Height="9" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Widget Micro-Meters -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="6,4" Margin="2,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}"/>
                                    <TextBlock Name="TxtWidgetCpu" Text="0%" DockPanel.Dock="Right" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetCpu" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentCpu}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="6,4" Margin="2,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="GPU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                    <TextBlock Name="TxtWidgetGpu" Text="0%" DockPanel.Dock="Right" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetGpu" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentGpu}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="6,4" Margin="2,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="RAM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentRam}"/>
                                    <TextBlock Name="TxtWidgetRam" Text="0%" DockPanel.Dock="Right" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetRam" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentRam}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="6,4" Margin="2,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="NET" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentNetwork}"/>
                                    <TextBlock Name="TxtWidgetNet" Text="0K" DockPanel.Dock="Right" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetNet" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentNetwork}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>