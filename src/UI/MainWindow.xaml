<Window x:Class="SimplePCMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple PC Monitor"
        Height="720" Width="980"
        MinWidth="860" MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <!-- Outer Card with Drop Shadow & Rounded Corners -->
    <Border Name="OuterBorder" Background="{DynamicResource BgApp}" CornerRadius="16" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.38" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Hero Circular Radial Gauges (4 Cards) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Live Historical Wave Sparkline Charts (CPU & Network Waves) -->
                <RowDefinition Height="Auto" Name="RowLiveWaves"/>
                <!-- Row 3: Secondary Content Area (Storage/Hardware + Detailed Tabs) -->
                <RowDefinition Height="*" Name="RowDeepDive"/>
                <!-- Row 4: Bottom Status Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- ROW 0: TOP HEADER & QUICK LAUNCH TOOLBAR   -->
            <!-- ========================================== -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Name="ImgAppLogo" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Simple PC Monitor" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="C# Native Direct3D" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                    <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Name="TxtUptime" Text="Uptime: 0d 0h" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                </StackPanel>

                <!-- Quick Native Tool Launchers & Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Quick Tool Buttons -->
                    <Button Name="BtnTaskMgr" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Open Task Manager" Click="BtnTaskMgr_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconLaunch}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="Taskmgr"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnResMon" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Open Resource Monitor" Click="BtnResMon_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconLaunch}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="Resmon"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnRelMon" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Open Reliability Monitor" Click="BtnRelMon_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconLaunch}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="Reliability"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnPCMgr" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Open PC Manager / Storage Sense" Click="BtnPCMgr_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconLaunch}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="PC Manager"/>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="{DynamicResource BorderCard}" Margin="6,0"/>

                    <!-- View Mode Toggle (Analytics vs Compact Widget) -->
                    <Button Name="BtnToggleView" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Switch View Mode (Full HUD / Hero / Mini Widget)" Click="BtnToggleView_Click">
                        <TextBlock Name="TxtViewMode" Text="Full HUD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    </Button>

                    <!-- Theme Switcher -->
                    <Button Name="BtnToggleTheme" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Toggle Light / Dark Mode" Click="BtnToggleTheme_Click">
                        <Path Data="{DynamicResource IconTheme}" Fill="{DynamicResource AccentMem}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Interval Toggle (3s / 5s) -->
                    <Button Name="BtnToggleInterval" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Switch Refresh Interval (3s / 5s)" Click="BtnToggleInterval_Click">
                        <TextBlock Name="TxtInterval" Text="3s" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    </Button>

                    <!-- Window Controls -->
                    <Button Name="BtnMinimize" Style="{DynamicResource WindowControlButtonStyle}" Margin="4,0,0,0" Click="BtnMinimize_Click">
                        <Path Data="{DynamicResource IconMinimize}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Name="BtnClose" Style="{DynamicResource WindowControlButtonStyle}" Click="BtnClose_Click">
                        <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- ROW 1: HERO CIRCULAR RADIAL GAUGES (4 CARDS)             -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" Margin="-6,0,-6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. CPU RADIAL GAUGE CARD -->
                <Border Grid.Column="0" Style="{DynamicResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconCpu}" Fill="{DynamicResource AccentCpu}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="CPU LOAD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource BgControl}" CornerRadius="3" Padding="4,1">
                                <TextBlock Name="TxtCpuCores" Text="8 Cores" FontSize="9" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </DockPanel>

                        <!-- Circular Radial Gauge Container -->
                        <Grid Grid.Row="1" Width="100" Height="90" Margin="0,6,0,4">
                            <!-- Background Track -->
                            <Path Stroke="{DynamicResource BgControl}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment Size="38,38" Point="49.99,12" SweepDirection="Clockwise" IsLargeArc="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <!-- Progress Arc -->
                            <Path Stroke="{DynamicResource AccentCpu}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment x:Name="ArcCpuSeg" Size="38,38" Point="50,12" SweepDirection="Clockwise" IsLargeArc="False"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <!-- Center Readout -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Name="TxtCpuVal" Text="0.0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="LOAD" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Name="TxtCpuSub" Text="Direct Win32 Kernel" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 2. MEMORY (RAM) RADIAL GAUGE CARD -->
                <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconRam}" Fill="{DynamicResource AccentMem}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="MEMORY (RAM)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource BgControl}" CornerRadius="3" Padding="4,1">
                                <TextBlock Name="TxtRamTotalBadge" Text="16 GB" FontSize="9" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </DockPanel>

                        <!-- Circular Radial Gauge Container -->
                        <Grid Grid.Row="1" Width="100" Height="90" Margin="0,6,0,4">
                            <Path Stroke="{DynamicResource BgControl}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment Size="38,38" Point="49.99,12" SweepDirection="Clockwise" IsLargeArc="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path Stroke="{DynamicResource AccentMem}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment x:Name="ArcRamSeg" Size="38,38" Point="50,12" SweepDirection="Clockwise" IsLargeArc="False"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Name="TxtRamVal" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="USED" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Name="TxtRamSub" Text="Used: 0 GB / Free: 0 GB" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 3. PRIMARY STORAGE RADIAL GAUGE CARD -->
                <Border Grid.Column="2" Style="{DynamicResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconDisk}" Fill="{DynamicResource AccentDisk}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Name="TxtDiskHeader" Text="PRIMARY DISK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource BgControl}" CornerRadius="3" Padding="4,1">
                                <TextBlock Name="TxtDiskTotalBadge" Text="NTFS" FontSize="9" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </DockPanel>

                        <!-- Circular Radial Gauge Container -->
                        <Grid Grid.Row="1" Width="100" Height="90" Margin="0,6,0,4">
                            <Path Stroke="{DynamicResource BgControl}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment Size="38,38" Point="49.99,12" SweepDirection="Clockwise" IsLargeArc="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path Stroke="{DynamicResource AccentDisk}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment x:Name="ArcDiskSeg" Size="38,38" Point="50,12" SweepDirection="Clockwise" IsLargeArc="False"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Name="TxtDiskVal" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="SPACE" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Name="TxtDiskSub" Text="Free: 0 GB / Total: 0 GB" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 4. NETWORK THROUGHPUT RADIAL GAUGE CARD -->
                <Border Grid.Column="3" Style="{DynamicResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconNetwork}" Fill="{DynamicResource AccentNet}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="NETWORK I/O" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource BgControl}" CornerRadius="3" Padding="4,1">
                                <TextBlock Name="TxtNetAdapter" Text="Wi-Fi" FontSize="9" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </DockPanel>

                        <!-- Circular Radial Gauge Container -->
                        <Grid Grid.Row="1" Width="100" Height="90" Margin="0,6,0,4">
                            <Path Stroke="{DynamicResource BgControl}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment Size="38,38" Point="49.99,12" SweepDirection="Clockwise" IsLargeArc="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path Stroke="{DynamicResource AccentNet}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,12">
                                            <ArcSegment x:Name="ArcNetSeg" Size="38,38" Point="50,12" SweepDirection="Clockwise" IsLargeArc="False"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Name="TxtNetVal" Text="0 KB/s" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="SPEED" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Name="TxtNetSub" Text="↓ 0 KB/s  ↑ 0 KB/s" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 2: LIVE REAL-TIME HISTORICAL WAVE SPARKLINE CHARTS (CPU & NETWORK)     -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="2" Margin="-6,0,-6,8" Name="ContainerLiveWaves">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU 30-Second Real-Time Wave Chart -->
                <Border Grid.Column="0" Style="{DynamicResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="65"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="CPU LOAD (30s LIVE WAVE)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Name="TxtCpuLivePeak" Text="Peak: 0%" DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource AccentCpu}"/>
                        </DockPanel>
                        <Canvas Grid.Row="1" Name="CanvasCpuGraph" Height="65" ClipToBounds="True" Background="Transparent">
                            <Polygon Name="PolyCpuArea" Fill="#2293A8FD"/>
                            <Polyline Name="LineCpuStroke" Stroke="{DynamicResource AccentCpu}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Network 30-Second Real-Time Wave Chart -->
                <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="65"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="NETWORK THROUGHPUT (30s LIVE WAVE)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Name="TxtNetLivePeak" Text="Peak: 0 KB/s" DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource AccentNet}"/>
                        </DockPanel>
                        <Canvas Grid.Row="1" Name="CanvasNetGraph" Height="65" ClipToBounds="True" Background="Transparent">
                            <Polygon Name="PolyNetArea" Fill="#227EE7B8"/>
                            <Polyline Name="LineNetStroke" Stroke="{DynamicResource AccentNet}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- ROW 3: DETAILED SYSTEM VIEWS (STORAGE & PROCESSES)       -->
            <!-- ======================================================== -->
            <Grid Grid.Row="3" Margin="-6,0" Name="ContainerDeepDive">
                <Grid.ColumnDefinitions>
                    <!-- Left: Hardware & Disks Overview (310px) -->
                    <ColumnDefinition Width="310"/>
                    <!-- Right: Tabbed Deep-Dive (Processes / Services / Tasks) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: HARDWARE & MULTI-DRIVE SUMMARY -->
                <StackPanel Grid.Column="0">
                    <!-- Hardware Overview Card -->
                    <Border Style="{DynamicResource MetricCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconHardware}" Fill="{DynamicResource AccentHardware}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="HARDWARE &amp; SYSTEM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Name="TxtBatteryState" Text="AC Power" DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StatusOk}"/>
                            </DockPanel>

                            <TextBlock Text="PROCESSOR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Name="TxtHwCpu" Text="Intel Core / AMD Ryzen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,1,0,4" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="GRAPHICS ADAPTER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Name="TxtHwGpu" Text="GPU Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,1,0,4" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="OPERATING SYSTEM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Name="TxtHwOs" Text="Windows 11" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Storage Volumes Card -->
                    <Border Style="{DynamicResource MetricCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconDisk}" Fill="{DynamicResource AccentDisk}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="STORAGE VOLUMES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </DockPanel>
                            
                            <ItemsControl Name="ListDrives">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding VolumeLabel}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FreeGB, StringFormat='{}{0} GB Free'}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                            </DockPanel>
                                            <ProgressBar Grid.Row="1" Value="{Binding PercentUsed}" Style="{DynamicResource PastelProgressBarStyle}" Foreground="{DynamicResource AccentDisk}" Margin="0,3,0,3"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: TABBED DEEP DIVE WITH VISUAL PROCESS BARS -->
                <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Name="TabBtnProcesses" Content="Top Processes" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnProcesses_Click"/>
                                <Button Name="TabBtnServices" Content="Services" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnServices_Click"/>
                                <Button Name="TabBtnTasks" Content="Scheduled Tasks" Style="{DynamicResource TabHeaderButtonStyle}" Click="TabBtnTasks_Click"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="TxtTabSummary" Text="Top 8 RAM consumers" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </DockPanel>

                        <!-- 1. TOP PROCESSES VIEW WITH INLINE VISUAL METERS -->
                        <Grid Grid.Row="1" Name="ViewProcesses" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Table Header -->
                            <Grid Grid.Row="0" Margin="4,0,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Grid.Column="1" Text="PROCESS NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Grid.Column="2" Text="WORKING SET" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="% RAM SHARE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <!-- Process List with Embedded Mini Visual ProgressBars -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="ListProcesses">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="8,4" Margin="0,2">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- PID Pill Badge -->
                                                        <Border Background="{DynamicResource BgApp}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Id}" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding MemoryDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding MemoryPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentMem}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <!-- Embedded Mini Visual Bar -->
                                                    <ProgressBar Grid.Row="1" Value="{Binding MemoryPercent}" Maximum="25" Style="{DynamicResource ProcessMiniProgressBarStyle}" Foreground="{DynamicResource AccentMem}" Margin="0,3,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 2. SERVICES VIEW -->
                        <Grid Grid.Row="1" Name="ViewServices" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="10,4" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Name="TxtServicesStats" Text="Services: 0 Running | 0 Stopped" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <Button Name="BtnOpenServicesMsc" Content="Manage in Services.msc" Style="{DynamicResource QuickActionButtonStyle}" DockPanel.Dock="Right" Padding="6,2" Click="BtnOpenServicesMsc_Click"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="ListServices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="8,5" Margin="0,2">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" Background="{DynamicResource BgApp}">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusOk}"/>
                                                    </Border>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 3. SCHEDULED TASKS VIEW -->
                        <Grid Grid.Row="1" Name="ViewTasks" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BgControl}" CornerRadius="6" Padding="10,4" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="Active Startup &amp; Maintenance Tasks" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <Button Name="BtnOpenTaskSchd" Content="Open Task Scheduler" Style="{DynamicResource QuickActionButtonStyle}" DockPanel.Dock="Right" Padding="6,2" Click="BtnOpenTaskSchd_Click"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="ListTasks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="8,5" Margin="0,2">
                                                <DockPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TaskName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TaskPath}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" Background="{DynamicResource BgApp}">
                                                        <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}"/>
                                                    </Border>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- ROW 4: BOTTOM STATUS BAR                   -->
            <!-- ========================================== -->
            <Grid Grid.Row="4" Margin="4,10,4,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Engine: " FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="C# P/Invoke &amp; Hardware Vector Wave (0.005ms)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Name="TxtStatusTimestamp" Text="Updated: Just now" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <Button Name="BtnManualRefresh" Style="{DynamicResource QuickActionButtonStyle}" DockPanel.Dock="Right" Padding="8,3" ToolTip="Force Refresh" Click="BtnManualRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconRefresh}" Fill="{DynamicResource TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh" FontSize="10"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
