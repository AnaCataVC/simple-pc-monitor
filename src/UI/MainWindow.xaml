                            </Button>
                            <Button Name="BtnWidgetClose" Style="{DynamicResource WindowCloseButtonStyle}" Width="22" Height="20" ToolTip="Cerrar" Click="BtnClose_Click">
                                <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondary}" Width="8" Height="8" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Widget Micro-Meters Grid (CPU, GPU, RAM, NET) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Micro CPU -->
                        <Border Grid.Column="0" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="CPU" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}"/>
                                    <TextBlock Name="TxtWidgetCpu" Text="0%" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetCpu" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentCpu}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Micro GPU -->
                        <Border Grid.Column="1" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="GPU" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}"/>
                                    <TextBlock Name="TxtWidgetGpu" Text="0%" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetGpu" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentGpu}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Micro RAM -->
                        <Border Grid.Column="2" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="RAM" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentMem}"/>
                                    <TextBlock Name="TxtWidgetRam" Text="0%" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetRam" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentMem}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Micro NET -->
                        <Border Grid.Column="3" Background="{DynamicResource BgControl}" CornerRadius="5" Padding="5,3" Margin="1.5,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="NET" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentNet}"/>
                                    <TextBlock Name="TxtWidgetNet" Text="0K" DockPanel.Dock="Right" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ProgressBar Name="ProgressWidgetNet" Value="0" Style="{DynamicResource MicroProgressBarStyle}" Foreground="{DynamicResource AccentNet}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
