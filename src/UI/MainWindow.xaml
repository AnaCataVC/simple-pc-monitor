                        <MenuItem Name="MenuWidgetSnap" Header="📍 Acoplar a la Esquina Inferior Derecha" Click="MenuWidgetSnap_Click"/>
                        <MenuItem Name="MenuWidgetPin" Header="📌 Fijar Siempre Visible (Always on Top)" Click="BtnPinTop_Click"/>
                        <Separator/>
                        <MenuItem Name="MenuWidgetClose" Header="❌ Cerrar Monitor" Click="BtnClose_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Widget Caption Line -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Name="ImgWidgetLogo" Width="14" Height="14" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
