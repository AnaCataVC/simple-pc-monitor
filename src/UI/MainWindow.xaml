                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColTaskName" Text="TAREA PROGRAMADA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="1" Name="TxtColTaskState" Text="ESTADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ListTasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="6,4" Margin="0,1.5" Tag="{Binding}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="▶️ Ejecutar Tarea Ahora" Click="MenuTaskRun_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="⏹️ Detener Tarea" Click="MenuTaskEnd_Click" Tag="{Binding}"/>
                                                            <Separator Background="{DynamicResource BorderCard}"/>
                                                            <MenuItem Header="📅 Abrir Programador de Tareas (taskschd.msc)" Click="MenuOpenTaskSchd_Click"/>
                                                            <MenuItem Header="🔍 Buscar Tarea en Google" Click="MenuTaskSearch_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="📋 Copiar Nombre de Tarea" Click="MenuTaskCopy_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="4,0,6,0">
                                                            <TextBlock Text="{Binding TaskName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TaskPath}" FontSize="8.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding State}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 5. STARTUP APPS VIEW -->
                            <Grid Grid.Row="1" Name="ViewStartup" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="TxtColStartupApp" Text="APLICACIÓN / PROGRAMA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
