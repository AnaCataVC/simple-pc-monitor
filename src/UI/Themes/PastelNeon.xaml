<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgApp" Color="#0B0E14"/>
    <SolidColorBrush x:Key="BgSurface" Color="#111622"/>
    <SolidColorBrush x:Key="BgCard" Color="#161C2B"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#1E273C"/>
    <SolidColorBrush x:Key="BgControl" Color="#222B3D"/>
    <SolidColorBrush x:Key="BgControlHover" Color="#2E3A52"/>
    <SolidColorBrush x:Key="BgControlActive" Color="#3C4B6B"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderCard" Color="#28344D"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#1C2436"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimary" Color="#00F5FF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#4A6587"/>

    <!-- Accents (Cyberpunk Neon Spectrum) -->
    <SolidColorBrush x:Key="AccentCpu" Color="#00F5FF"/>
    <SolidColorBrush x:Key="AccentCpuAlpha" Color="#2200F5FF"/>
    <SolidColorBrush x:Key="AccentGpu" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentGpuAlpha" Color="#2238BDF8"/>
    <SolidColorBrush x:Key="AccentNpu" Color="#FF007F"/>
    <SolidColorBrush x:Key="AccentNpuAlpha" Color="#22FF007F"/>
    <SolidColorBrush x:Key="AccentMem" Color="#FFE600"/>
    <SolidColorBrush x:Key="AccentMemAlpha" Color="#22FFE600"/>
    <SolidColorBrush x:Key="AccentDisk" Color="#A855F7"/>
    <SolidColorBrush x:Key="AccentDiskAlpha" Color="#22A855F7"/>
    <SolidColorBrush x:Key="AccentNet" Color="#00FF88"/>
    <SolidColorBrush x:Key="AccentNetAlpha" Color="#2200FF88"/>
    <SolidColorBrush x:Key="AccentHardware" Color="#BF5AF2"/>

    <!-- Health / Status -->
    <SolidColorBrush x:Key="StatusOk" Color="#00FF88"/>
    <SolidColorBrush x:Key="StatusWarn" Color="#FFE600"/>
    <SolidColorBrush x:Key="StatusCrit" Color="#FF0055"/>
</ResourceDictionary>
