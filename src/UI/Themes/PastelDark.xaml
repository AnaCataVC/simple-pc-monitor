<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgApp" Color="#12131A"/>
    <SolidColorBrush x:Key="BgSurface" Color="#1A1C26"/>
    <SolidColorBrush x:Key="BgCard" Color="#212433"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#2A2E40"/>
    <SolidColorBrush x:Key="BgControl" Color="#2D3245"/>
    <SolidColorBrush x:Key="BgControlHover" Color="#3A3F55"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderCard" Color="#2E3348"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#232738"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F5FB"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8F97B2"/>
    <SolidColorBrush x:Key="TextMuted" Color="#606884"/>

    <!-- Accents (Pastel Spectrum) -->
    <SolidColorBrush x:Key="AccentCpu" Color="#93A8FD"/>
    <SolidColorBrush x:Key="AccentMem" Color="#BBA3F9"/>
    <SolidColorBrush x:Key="AccentDisk" Color="#7AE5F5"/>
    <SolidColorBrush x:Key="AccentNet" Color="#7EE7B8"/>
    <SolidColorBrush x:Key="AccentHardware" Color="#FBD38D"/>

    <!-- Health / Status -->
    <SolidColorBrush x:Key="StatusOk" Color="#7EE7B8"/>
    <SolidColorBrush x:Key="StatusWarn" Color="#FFC371"/>
    <SolidColorBrush x:Key="StatusCrit" Color="#FF7E8D"/>
</ResourceDictionary>
