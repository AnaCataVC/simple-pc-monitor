<Window x:Class="SimplePCMonitor.Installer.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple PC Monitor Setup Wizard"
        Height="420" Width="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Border Background="#161822" CornerRadius="12" BorderBrush="#2D3245" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar -->
                <RowDefinition Height="38"/>
                <!-- Wizard Content Area -->
                <RowDefinition Height="*"/>
                <!-- Bottom Buttons -->
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 1. Custom TitleBar -->
            <Grid Grid.Row="0" Background="#1B1E2B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🖥️ Simple PC Monitor — Setup Wizard" FontWeight="Bold" FontSize="12" Foreground="#F2F5FB"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="38" Height="38" Background="Transparent" Foreground="#8F97B2" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- 2. Wizard Pages Container -->
            <Grid Grid.Row="1" Margin="24,18,24,10">
                <!-- STEP 1: WELCOME -->
                <Grid Name="PageWelcome" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#212433" CornerRadius="20" Padding="18" Width="100" Height="100" HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Welcome to Simple PC Monitor Setup" FontSize="17" FontWeight="Bold" Foreground="#F2F5FB" Margin="0,0,0,8"/>
                        <TextBlock Text="This wizard will install Simple PC Monitor v2.4.0 on your computer." FontSize="11" Foreground="#8F97B2" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Background="#212433" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="✓ Real-Time CPU, RAM, Disk &amp; Network Telemetry" FontSize="11" Foreground="#7EE7B8" Margin="0,2"/>
                                <TextBlock Text="✓ 1-Click Power Plan Switcher (Eco / Turbo)" FontSize="11" Foreground="#93A8FD" Margin="0,2"/>
                                <TextBlock Text="✓ Safe Process Termination &amp; Temp Cleaner" FontSize="11" Foreground="#BBA3F9" Margin="0,2"/>
                                <TextBlock Text="✓ Single Native C# Binary (Zero Dependencies)" FontSize="11" Foreground="#FBD38D" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 2: INSTALLATION OPTIONS -->
                <Grid Name="PageOptions" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Installation Folder &amp; Shortcuts" FontSize="15" FontWeight="Bold" Foreground="#F2F5FB" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Destination Folder:" FontSize="11" FontWeight="SemiBold" Foreground="#8F97B2" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxtInstallDir" Background="#212433" Foreground="#F2F5FB" BorderBrush="#2D3245" Padding="8,5" FontSize="11" IsReadOnly="True"/>
                        </Grid>

                        <TextBlock Text="Additional Shortcuts:" FontSize="11" FontWeight="SemiBold" Foreground="#8F97B2" Margin="0,0,0,6"/>
                        <CheckBox Name="ChkDesktopShortcut" Content="Create a Desktop Shortcut" IsChecked="True" Foreground="#F2F5FB" FontSize="11" Margin="0,3"/>
                        <CheckBox Name="ChkStartMenu" Content="Create a Start Menu Shortcut" IsChecked="True" Foreground="#F2F5FB" FontSize="11" Margin="0,3"/>
                        <CheckBox Name="ChkStartup" Content="Launch automatically when Windows starts" IsChecked="False" Foreground="#F2F5FB" FontSize="11" Margin="0,3"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: INSTALLING PROGRESS -->
                <Grid Name="PageInstalling" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Installing Simple PC Monitor..." FontSize="16" FontWeight="Bold" Foreground="#F2F5FB" Margin="0,0,0,8"/>
                        <TextBlock Name="TxtInstallStatus" Text="Extracting files..." FontSize="11" Foreground="#8F97B2" Margin="0,0,0,14"/>
                        <ProgressBar Name="ProgInstall" Height="10" Minimum="0" Maximum="100" Value="20" Background="#212433" Foreground="#93A8FD" BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: FINISHED -->
                <Grid Name="PageFinished" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#1C2E2A" CornerRadius="20" Padding="16" Width="90" Height="90" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="44" Foreground="#7EE7B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Installation Completed!" FontSize="17" FontWeight="Bold" Foreground="#F2F5FB" Margin="0,0,0,8"/>
                        <TextBlock Text="Simple PC Monitor has been successfully installed on your computer." FontSize="11" Foreground="#8F97B2" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <CheckBox Name="ChkLaunchAfter" Content="Launch Simple PC Monitor now" IsChecked="True" Foreground="#7EE7B8" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 3. Bottom Action Bar -->
            <Border Grid.Row="2" Background="#1B1E2B" CornerRadius="0,0,12,12" Padding="18,10">
                <DockPanel>
                    <TextBlock Text="v2.4.0 • C# WPF Standalone" FontSize="10" Foreground="#606884" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Name="BtnBack" Content="Back" Width="75" Height="28" Background="#212433" Foreground="#8F97B2" BorderThickness="0" Margin="4,0" Cursor="Hand" Click="BtnBack_Click" Visibility="Collapsed"/>
                        <Button Name="BtnNext" Content="Next >" Width="85" Height="28" Background="#93A8FD" Foreground="#12131A" FontWeight="Bold" BorderThickness="0" Margin="4,0" Cursor="Hand" Click="BtnNext_Click"/>
                        <Button Name="BtnCancel" Content="Cancel" Width="75" Height="28" Background="#212433" Foreground="#8F97B2" BorderThickness="0" Margin="4,0" Cursor="Hand" Click="BtnClose_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
