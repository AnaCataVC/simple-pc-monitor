<UserControl x:Class="SystemCoreMonitor.Views.AcceleratorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:SystemCoreMonitor.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
        <StackPanel>
            <!-- Disabled State Banner -->
            <Border Padding="20,16" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource BentoCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="💤" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DisabledNotice}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisabledHint}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- Active Monitoring Content -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- GPU Dedicated Card -->
                <Border Style="{StaticResource BentoCardStyle}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- GPU Header: Dock Right first, then fill Left -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" 
                                       Text="{Binding Gpu.LoadPercent, StringFormat='{}Carga: {0:F0}%'}" 
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentGpu}" 
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGpu}" Fill="{DynamicResource AccentGpu}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Gpu.Name, FallbackValue='GPU'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Gpu.Vendor, FallbackValue='Adaptador de Pantalla DirectX'}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- VRAM Progress -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="Memoria VRAM Dedicada:" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Gpu.DedicatedVramPercent, StringFormat='{}{0:F1}%'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource PastelProgressBarStyle}" Value="{Binding Gpu.DedicatedVramPercent}" Foreground="{DynamicResource AccentGpu}" Height="8" Margin="0,0,0,12"/>

                        <!-- GPU Engines Breakdown Grid -->
                        <UniformGrid Columns="3" Margin="0,6,0,0">
                            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Render 3D" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Gpu.Engines.Engine3DPercent, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="Cómputo DirectML" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Gpu.Engines.ComputePercent, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Decodificación Video" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Gpu.Engines.VideoDecodePercent, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- NPU / Neural Processing Unit Card -->
                <Border Style="{StaticResource BentoCardStyle}" Padding="18,14">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource BgControlHover}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding Npu.Status}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNpu}" Fill="{DynamicResource AccentCpu}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NPU (Neural Processing Unit)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Acelerador de Inteligencia Artificial para Windows Copilot+ PC" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>