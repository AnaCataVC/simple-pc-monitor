<UserControl x:Class="SystemCoreMonitor.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Search Bar & Sorters -->
        <Border Grid.Row="0" Style="{StaticResource BentoCardStyle}" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="260" Padding="8,4" FontSize="13" Background="{DynamicResource BgControl}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Ordenar por:" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding SortCommand}" CommandParameter="Cpu" Content="CPU" Margin="0,0,4,0" Padding="10,4"/>
                    <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding SortCommand}" CommandParameter="Ram" Content="RAM" Margin="0,0,4,0" Padding="10,4"/>
                    <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding SortCommand}" CommandParameter="Name" Content="Nombre" Margin="0,0,4,0" Padding="10,4"/>
                    <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding SortCommand}" CommandParameter="Pid" Content="PID" Padding="10,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Runaway Processes Alert Card (disk-wide scans, sustained CPU) -->
        <Border Grid.Row="1" Style="{StaticResource BentoCardStyle}" Background="#2D1F0F" BorderBrush="#F59E0B" Padding="14,10" Margin="0,0,0,10"
                Visibility="{Binding HasRunaway, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="🔥" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding RunawayTitle}" FontSize="13.5" FontWeight="Bold" Foreground="#FCD34D"/>
                        <TextBlock Text="{Binding RunawaySubtitle}" FontSize="11.5" Foreground="#FBBF24" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RunawayProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3B2A12" BorderBrush="#78350F" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" ToolTip="{Binding CommandLine}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="White" Margin="0,0,8,2" VerticalAlignment="Center"/>
                                                <Border Background="#451A03" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FCD34D"/>
                                                </Border>
                                                <Border Background="#451A03" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Pid, StringFormat='{}PID: {0}'}" FontSize="11" Foreground="#FDE68A"/>
                                                </Border>
                                                <Border Background="#451A03" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CpuPercent, StringFormat='{}CPU: {0:F1}%'}" FontSize="11" Foreground="#FDE68A"/>
                                                </Border>
                                                <Border Background="#451A03" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AgeDisplay, StringFormat='{}⏱ {0}'}" FontSize="11" Foreground="#FDE68A"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Reason}" FontSize="11.5" Foreground="#FBBF24" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding CommandLine}" FontSize="11" FontFamily="Consolas" Foreground="#D6D3D1" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PillActionButtonStyle}"
                                                Command="{Binding DataContext.EndRunawayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#EF4444" Foreground="White" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.RunawayEndLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Process Items ListView with Larger Fonts & Clean Spacing -->
        <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}" Padding="4">
            <ListView ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" 
                      Background="Transparent" BorderThickness="0" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" Margin="0,2" CornerRadius="8" Background="{DynamicResource BgControl}">
                            <DockPanel LastChildFill="True">
                                <!-- Action Buttons on the Right -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Style="{StaticResource PillActionButtonStyle}" 
                                            Command="{Binding DataContext.TerminateProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#15EF4444" Foreground="#EF4444" Padding="10,5" MinWidth="68" ToolTip="Finalizar proceso de forma segura">
                                        <TextBlock Text="Cerrar" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <!-- Telemetry Badges -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <!-- CPU Badge -->
                                    <Border Background="{DynamicResource BgControlHover}" CornerRadius="4" Padding="8,4" MinWidth="84" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding CpuPercent, StringFormat='{}CPU: {0:F1}%'}" Foreground="{DynamicResource AccentCpu}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <!-- RAM Badge -->
                                    <Border Background="{DynamicResource BgControlHover}" CornerRadius="4" Padding="8,4" MinWidth="96">
                                        <TextBlock Text="{Binding MemoryMB, StringFormat='{}RAM: {0:F0} MB'}" Foreground="{DynamicResource AccentRam}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Process Icon & Name -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                            <TextBlock Text="{Binding Id, StringFormat='{} (PID {0})'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>