<UserControl x:Class="SystemCoreMonitor.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Services Summary Header -->
        <Border Grid.Row="0" Style="{StaticResource BentoCardStyle}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconService}" Fill="{DynamicResource AccentCpu}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Servicios Esenciales de Windows" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Control y monitoreo de servicios críticos del sistema" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgControlHover}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Metric.RunningCount, StringFormat='{}En ejecución: {0}'}" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                    </Border>
                    <Border Background="{DynamicResource BgControlHover}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Metric.StoppedCount, StringFormat='{}Detenidos: {0}'}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"/>
                    </Border>
                    <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding OpenServicesConsoleCommand}" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Consola de Servicios" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Services List -->
        <Border Grid.Row="1" Style="{StaticResource BentoCardStyle}" Padding="8">
            <ListView ItemsSource="{Binding Services}" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgControl}" CornerRadius="8" Padding="14,10" Margin="0,2">
                            <DockPanel LastChildFill="True">
                                <!-- Action Buttons (Right) -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Style="{StaticResource PillActionButtonStyle}" 
                                            Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#1510B981" Foreground="#10B981" Padding="10,5" MinWidth="68" Margin="0,0,6,0">
                                        <TextBlock Text="Iniciar" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource PillActionButtonStyle}" 
                                            Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#15EF4444" Foreground="#EF4444" Padding="10,5" MinWidth="68" Margin="0,0,6,0">
                                        <TextBlock Text="Detener" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource PillActionButtonStyle}" 
                                            Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5" MinWidth="68">
                                        <TextBlock Text="Reiniciar" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,4" MinWidth="105" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#15F59E0B"/>
                                            <Setter Property="BorderBrush" Value="#33F59E0B"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="#1510B981"/>
                                                    <Setter Property="BorderBrush" Value="#3310B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Service Info -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ServiceName}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>